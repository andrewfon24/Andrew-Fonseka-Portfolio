---
// A result figure that counts up on entry. The final value is always in the
// HTML; the counter only animates the visible copy.
const { value, count, prefix = "", suffix = "", dark = false, class: className } = Astro.props;
---

<span class:list={["figure", dark && "figure--dark", className]}>
  {
    count !== undefined ? (
      <>
        <span aria-hidden="true" data-count={count} data-prefix={prefix} data-suffix={suffix}>
          {value}
        </span>
        <span class="visually-hidden">{value}</span>
      </>
    ) : (
      value
    )
  }
</span>
