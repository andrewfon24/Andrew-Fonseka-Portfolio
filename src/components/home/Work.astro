---
import Figure from "../Figure.astro";
import Split from "../charts/Split.astro";
import Columns from "../charts/Columns.astro";
import Chapter from "./Chapter.astro";
import { caseById, decision } from "../../content/site.js";

const uni = caseById.university;
const pan = caseById.panasia;
const pet = caseById.petmart;
const dats = caseById.dats;
const max = Math.max(...decision.rows.map((r) => r.value));
---

<section class="band band--paper" id="work" aria-labelledby="work-title">
  <div class="container">
    <div class="head" data-rise>
      <h2 id="work-title">Every result here <span class="accent">ends at a customer.</span></h2>
      <p>
        Four accounts, told the same way: the problem, the decision, and what the client’s own system recorded.
      </p>
    </div>

    <div class="chapters">
      <Chapter
        id="university"
        chips={[uni.clientShort, uni.context, uni.period]}
        headline={decision.headline}
        problem={uni.problem}
        decision={uni.decision}
        result={uni.result}
        role={decision.role}
        stats={uni.stats}
        note={decision.note}
      >
        <figure class="compare" data-draw>
          <figcaption class="chart-title"><strong>{decision.chartTitle}</strong></figcaption>
          {
            decision.rows.map((r, i) => (
              <div class:list={["compare__row", r.win && "compare__row--win"]}>
                <span class="compare__name">
                  {r.name}
                  <small>{r.leads}</small>
                </span>
                <span class="compare__track">
                  <span
                    class:list={["bar-fill", r.win && "bar-fill--gold"]}
                    style={`--v: ${(r.value / max).toFixed(3)}; --delay: ${200 + i * 180}ms`}
                  />
                </span>
                <Figure value={String(r.value)} count={r.value} class="compare__value" />
              </div>
            ))
          }
        </figure>
      </Chapter>

      <Chapter
        id="panasia"
        delay={100}
        chips={[pan.client, pan.context, pan.period]}
        headline={pan.headline}
        problem={pan.problem}
        decision={pan.decision}
        result={pan.result}
        role={pan.roleShort}
        stats={pan.stats.slice(0, 2)}
        note="Funded loans are client-reported. Channel-level loan counts are not available."
      >
        <div class="chart-title"><strong>How the US$25K was allocated</strong><span>Set by lead quality, from the start</span></div>
        <Split />
      </Chapter>

      <Chapter
        id="petmart"
        chips={[pet.client, pet.context, pet.period]}
        headline={pet.headline}
        problem={pet.problem}
        decision={pet.decision}
        decisionLabel="The actions"
        result={pet.result}
        role={pet.roleShort}
        stats={pet.stats}
        note="Client-reported. First-order ROAS excludes customer lifetime value and is not an incrementality test."
      >
        <div class="chart-title"><strong>Indexed change on the previous quarter</strong><span>Before = 100, client-reported</span></div>
        <Columns
          height="7.5rem"
          label="Indexed change: sales 100 before, 140 after; subscriptions 100 before, 130 after"
          bars={[
            { label: "Sales before", value: 100, tone: "soft" },
            { label: "Sales after", value: 140 },
            { label: "Subs. before", value: 100, tone: "soft" },
            { label: "Subs. after", value: 130 },
          ]}
        />
      </Chapter>

      <Chapter
        id="dats"
        delay={100}
        chips={[dats.clientShort, dats.context, dats.period]}
        headline={dats.headline}
        problem={dats.problem}
        decision={dats.decision}
        result={dats.result}
        role={dats.roleShort}
        stats={dats.stats}
        note="Combined change across consecutive quarters, not a controlled test."
      >
        <div class="chart-title"><strong>CRM-qualified leads per quarter</strong><span>Same qualification rule, client-reported</span></div>
        <Columns
          height="7.5rem"
          label="CRM-qualified leads: 178 in December 2025 to February 2026, 212 in March to May 2026"
          bars={[
            { label: "Dec 2025 to Feb 2026", value: 178, tone: "soft" },
            { label: "Mar to May 2026", value: 212, tone: "gold" },
          ]}
        />
      </Chapter>
    </div>

    <p class="fine chapters__note">
      Figures are client-reported where stated.
    </p>
  </div>
</section>
