---
import Icon from "../Icon.astro";
import Figure from "../Figure.astro";
import Split from "../charts/Split.astro";
import Columns from "../charts/Columns.astro";
import FunnelCrmDemo from "../../islands/FunnelCrmDemo.tsx";
import { caseById } from "../../content/site.js";

const uni = caseById.university;
const pan = caseById.panasia;
const pet = caseById.petmart;
const dats = caseById.dats;
---

<section class="band band--paper" id="work" aria-labelledby="work-title">
  <div class="container">
    <div class="head" data-rise>
      <h2 id="work-title">Judged in the CRM, <span class="accent">not the ad platform.</span></h2>
      <p>
        Four quantified case studies, plus a confidential Aegon operating-process case below. Each result ends at a
        customer: an enrolment, a funded loan, a first order.
      </p>
    </div>

    <article class="feature" data-rise aria-labelledby="feature-title">
      <div class="feature__copy">
        <ul class="card__meta chips" aria-label="Context">
          <li class="chip">{uni.sector}</li>
          <li class="chip">{uni.context}</li>
          <li class="chip">{uni.period}</li>
        </ul>
        <h3 id="feature-title">{uni.headline[0]}{" "}<span class="accent">{uni.headline[1]}</span></h3>
        <p class="card__role"><b>My role.</b> {uni.roleShort}</p>
        <div class="stat-pair">
          {
            uni.stats.map((s) => (
              <div class="stat">
                <Figure value={s.value} count={s.count} prefix={s.prefix} suffix={s.suffix} />
                <span class="stat__label">{s.label}</span>
              </div>
            ))
          }
        </div>
        <div>
          <a class="button button--solid" href="/case-studies/university/" data-track="case_open" data-case="university" data-where="work">
            Read the case study <Icon name="arrow-right" size={17} class="icon-nudge" />
          </a>
        </div>
      </div>
      <div class="feature__demo demo">
        <div aria-hidden="true" data-ss-fill>
          <FunnelCrmDemo client:visible />
        </div>
        <p class="visually-hidden">
          Illustrative CRM view: filtering 821 Meta leads to 430 CRM-qualified leads and 312 fee-paid enrolments, matched on name, phone and student ID.
        </p>
        <div class="demo__label"><span class="fine">Illustrative CRM view of the real funnel. No student data.</span></div>
      </div>
    </article>

    <div class="bento">
      <article class="card card--link" data-rise aria-labelledby="pan-title">
        <a class="card__cover" href="/case-studies/panasia/" data-track="case_open" data-case="panasia" data-where="work" aria-labelledby="pan-title"></a>
        <ul class="card__meta chips" aria-label="Context">
          <li class="chip">{pan.client}</li>
          <li class="chip">{pan.context}</li>
          <li class="chip">{pan.period}</li>
        </ul>
        <h3 id="pan-title">{pan.headline[0]}{" "}<span class="accent">{pan.headline[1]}</span></h3>
        <p class="card__role"><b>My role.</b> {pan.roleShort}</p>
        <div class="stat-pair">
          {
            pan.stats.slice(0, 2).map((s) => (
              <div class="stat">
                <Figure value={s.value} count={s.count} prefix={s.prefix} suffix={s.suffix} />
                <span class="stat__label">{s.label}</span>
              </div>
            ))
          }
        </div>
        <Split />
        <div class="card__foot">
          <span class="fine">Client-reported funded loans</span>
          <span class="link">Read the case study <Icon name="arrow-right" size={16} /></span>
        </div>
      </article>

      <article class="card card--link" data-rise style="--delay: 100ms" aria-labelledby="pet-title">
        <a class="card__cover" href="/case-studies/petmart/" data-track="case_open" data-case="petmart" data-where="work" aria-labelledby="pet-title"></a>
        <ul class="card__meta chips" aria-label="Context">
          <li class="chip">{pet.client}</li>
          <li class="chip">{pet.period}</li>
        </ul>
        <h3 id="pet-title">{pet.headline[0]}{" "}<span class="accent">{pet.headline[1]}</span></h3>
        <p class="card__role"><b>My role.</b> {pet.roleShort}</p>
        <div class="stat">
          <Figure value="4:1" count={4} suffix=":1" />
          <span class="stat__label">first-order ROAS, Shopping and PMax</span>
        </div>
        <div>
          <div class="chart-title"><strong>Indexed change</strong><span>Before = 100, client-reported</span></div>
          <Columns
            height="8.5rem"
            label="Indexed change: sales 100 before, 140 after; subscriptions 100 before, 130 after"
            bars={[
              { label: "Sales before", value: 100, tone: "soft" },
              { label: "Sales after", value: 140 },
              { label: "Subs. before", value: 100, tone: "soft" },
              { label: "Subs. after", value: 130 },
            ]}
          />
        </div>
        <div class="card__foot">
          <span class="link">Read the case study <Icon name="arrow-right" size={16} /></span>
        </div>
      </article>

      <article class="card card--link card--wide" data-rise aria-labelledby="dats-title">
        <a class="card__cover" href="/case-studies/dats/" data-track="case_open" data-case="dats" data-where="work" aria-labelledby="dats-title"></a>
        <div class="card__body">
          <ul class="card__meta chips" aria-label="Context">
            <li class="chip">{dats.clientShort}</li>
            <li class="chip">{dats.context}</li>
            <li class="chip">{dats.period}</li>
          </ul>
          <h3 id="dats-title">{dats.headline[0]}{" "}<span class="accent">{dats.headline[1]}</span></h3>
          <p class="card__role"><b>My role.</b> {dats.roleShort}</p>
          <div class="stat-pair">
            {
              dats.stats.map((s) => (
                <div class="stat">
                  <Figure value={s.value} count={s.count} prefix={s.prefix} suffix={s.suffix} />
                  <span class="stat__label">{s.label}</span>
                </div>
              ))
            }
          </div>
          <div class="card__foot">
            <span class="fine">Combined change, not a controlled test</span>
            <span class="link">Read the case study <Icon name="arrow-right" size={16} /></span>
          </div>
        </div>
        <div>
          <div class="chart-title"><strong>CRM-qualified leads per quarter</strong><span>Same qualification rule, client-reported</span></div>
          <Columns
            height="9rem"
            label="CRM-qualified leads: 178 in December 2025 to February 2026, 212 in March to May 2026"
            bars={[
              { label: "Dec 2025 to Feb 2026", value: 178, tone: "soft" },
              { label: "Mar to May 2026", value: 212, tone: "gold" },
            ]}
          />
        </div>
      </article>

    </div>
    <p class="fine" style="margin-top: var(--space-6)">
      Figures are client-reported where stated. Employer results from Aegon are confidential and are not shown.
    </p>
  </div>
</section>
