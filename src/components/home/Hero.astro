---
import Icon from "../Icon.astro";
import Figure from "../Figure.astro";
import { profile, mailto, metrics } from "../../content/site.js";
---

<section class="band band--dark hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <h1 id="hero-title">Paid media judged on <span class="accent">customers, not clicks.</span></h1>
      <p class="hero__lede">
        I connect media, measurement and the customer journey across in-house, agency and independent work.
      </p>
      <div class="actions">
        <a class="button button--primary" href={mailto} data-track="email_click" data-where="hero">
          <Icon name="mail" size={18} />Email me
        </a>
        <a class="button button--ghost" href={profile.resume} download data-track="resume_download" data-where="hero">
          <Icon name="download" size={18} />Download résumé
        </a>
      </div>
      <ul class="hero__facts" aria-label="At a glance">
        <li class="chip status"><Icon name="badge" size={14} />{profile.status}</li>
        <li class="chip"><Icon name="cap" size={14} />MBA</li>
        <li class="chip">Authorized to work in Canada</li>
      </ul>
    </div>

    <div class="hero__visual">
      <figure class="portrait">
        <img
          src="/images/andrew-fonseka-480.webp"
          srcset="/images/andrew-fonseka-240.webp 240w, /images/andrew-fonseka-480.webp 480w, /images/andrew-fonseka.jpg 1122w"
          sizes="(max-width: 640px) 72vw, 26rem"
          alt="Andrew Fonseka"
          width="1122"
          height="1402"
          fetchpriority="high"
        />
      </figure>
    </div>
  </div>
</section>

<section class="band band--dark metrics" aria-label="At a glance">
  <div class="container metrics__grid">
    {
      metrics.map((m, i) => (
        <div class="metrics__item" data-rise style={`--delay: ${i * 90}ms`}>
          <Figure dark value={m.value} count={m.count} suffix={m.suffix} class="metrics__value" />
          <span class="metrics__label">{m.label}</span>
        </div>
      ))
    }
  </div>
</section>
