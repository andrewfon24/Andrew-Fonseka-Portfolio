---
import Icon from "../Icon.astro";
import Figure from "../Figure.astro";
import { profile, mailto, metrics } from "../../content/site.js";
---

<section class="band band--dark hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <h1 id="hero-title">Paid media judged on <span class="accent">customers,</span> not clicks.</h1>
      <p class="hero__lede">
        I’m Andrew, a paid media strategist. I plan and run paid search and paid social, then{" "}
        <strong>follow every lead into the CRM</strong>{" "}to see which ones became enrolments, funded loans and first
        orders.
      </p>
      <div class="actions">
        <a class="button button--primary" href={mailto} data-track="email_click" data-where="hero">
          <Icon name="mail" size={18} />Email me
        </a>
        <a class="button button--ghost" href="#work" data-track="case_list" data-where="hero">
          See the results <Icon name="arrow-down" size={18} />
        </a>
      </div>
      <p class="hero__status">
        <span class="hero__dot" aria-hidden="true"></span>
        {profile.status}. {profile.eligibility}.
      </p>
    </div>

    <div class="hero__visual">
      <figure class="portrait">
        <img
          src="/images/andrew-fonseka-480.webp"
          srcset="/images/andrew-fonseka-240.webp 240w, /images/andrew-fonseka-480.webp 480w, /images/andrew-fonseka.jpg 1122w"
          sizes="(max-width: 640px) 72vw, 26rem"
          alt="Andrew Fonseka"
          width="1122"
          height="1402"
          fetchpriority="high"
        />
      </figure>
    </div>
  </div>

  <div class="container">
    <dl class="metrics" aria-label="At a glance">
      {
        metrics.map((m) => (
          <div class="metrics__item">
            <dt class="metrics__label">{m.label}</dt>
            <dd>
              <Figure dark value={m.value} count={m.count} suffix={m.suffix} class="metrics__value" />
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
