---
import Icon from "../Icon.astro";
import Figure from "../Figure.astro";
import { profile, mailto, accounts, university, caseById } from "../../content/site.js";

const uni = caseById.university;
const [leads, qualified, enrolled] = university.funnel;
const share = (n) => (n / leads.value).toFixed(3);
---

<section class="band band--dark hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <h1 id="hero-title">Paid media judged on <span class="accent">customers,</span> not clicks.</h1>
      <p class="hero__lede">
        I’m Andrew, a paid media strategist. I plan and run paid search and paid social, then{" "}
        <strong>follow every lead into the CRM</strong>{" "}to see which ones became enrolments, funded loans and first
        orders.
      </p>
      <div class="actions">
        <a class="button button--primary" href={mailto} data-track="email_click" data-where="hero">
          <Icon name="mail" size={18} />Email me
        </a>
        <a class="button button--ghost" href="#decision" data-track="case_list" data-where="hero">
          See the decisions <Icon name="arrow-down" size={18} />
        </a>
      </div>
      <p class="hero__status">
        <span class="hero__dot" aria-hidden="true"></span>
        {profile.status}. {profile.eligibility}.
      </p>
    </div>

    <a
      class="signal"
      href="/case-studies/university/"
      data-track="case_open"
      data-case="university"
      data-where="hero"
    >
      <span class="signal__head">
        <span>{uni.clientShort}</span>
        <span>{uni.period}</span>
      </span>
      <span class="signal__row" style="--v: 1">
        <span class="signal__top">
          <span>{leads.label}</span>
          <Figure dark value={String(leads.value)} count={leads.value} />
        </span>
        <span class="signal__track"><span class="signal__bar"></span></span>
      </span>
      <span class="signal__row" style={`--v: ${share(qualified.value)}; --delay: 160ms`}>
        <span class="signal__top">
          <span>{qualified.label}</span>
          <Figure dark value={String(qualified.value)} count={qualified.value} />
        </span>
        <span class="signal__track"><span class="signal__bar signal__bar--mid"></span></span>
      </span>
      <span class="signal__row signal__row--win" style={`--v: ${share(enrolled.value)}; --delay: 320ms`}>
        <span class="signal__top">
          <span>{enrolled.label}</span>
          <Figure dark value={String(enrolled.value)} count={enrolled.value} />
        </span>
        <span class="signal__track"><span class="signal__bar signal__bar--win"></span></span>
      </span>
      <span class="signal__foot">
        <span>The number I report on is the last one, matched in the admissions CRM on name, phone and student ID.</span>
        <span class="signal__more">Read the case <Icon name="arrow-right" size={15} /></span>
      </span>
    </a>
  </div>

  <div class="container accounts">
    <p>Accounts I’ve led or supported, agency and in-house</p>
    <ul>
      {accounts.map((name) => <li>{name}</li>)}
    </ul>
  </div>
</section>
