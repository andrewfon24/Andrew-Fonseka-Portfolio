---
import Icon from "../Icon.astro";
import { questions, mailto } from "../../content/site.js";
---

<section class="band band--paper band--tight" id="questions" aria-labelledby="questions-title">
  <div class="container questions__grid">
    <div class="questions__head" data-rise>
      <h2 id="questions-title">Questions you’re <span class="accent">about to ask.</span></h2>
      <p>The fair doubts about my background, answered before the interview.</p>
      <a class="link" href={mailto} data-track="email_click" data-where="questions">
        Ask me another one <Icon name="arrow-right" size={16} />
      </a>
    </div>
    <dl class="questions">
      {
        questions.map((item, i) => (
          <div class="question" data-rise style={`--delay: ${i * 70}ms`}>
            <dt>{item.q}</dt>
            <dd>
              {item.a}
              {item.link && (
                <a class="link" href={item.link.href} data-track="case_open" data-where="questions">
                  {item.link.label} <Icon name="arrow-right" size={15} />
                </a>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
