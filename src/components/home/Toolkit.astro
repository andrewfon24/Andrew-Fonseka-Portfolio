---
import BrandIcon from "../../BrandIcon.jsx";
import Icon from "../Icon.astro";
import { stackGroups, certifications, languages } from "../../content/site.js";
---

<section class="band band--surface band--tight stack" id="toolkit" aria-labelledby="toolkit-title">
  <div class="container">
    <div class="stack__head" data-rise>
      <div>
        <p class="kicker">Stack &amp; credentials</p>
        <h2 id="toolkit-title">The platforms I use.<br />The thinking comes first.</h2>
      </div>
      <p class="stack__intro">
        Paid search, paid social, measurement and the tools that help me keep the account and the team connected.
      </p>
    </div>

    <div class="stack__groups">
      {
        [
          stackGroups.filter((g) => ["paid", "productivity", "cms"].includes(g.id)),
          stackGroups.filter((g) => ["analytics", "email"].includes(g.id)),
        ].map((column) => (
          <div class="stack__column">
            {column.map((g) => (
              <div class="stack__group" data-rise>
                <h3 class="group-label">{g.name}</h3>
                <ul class="tools">
                  {g.tools.map((t) => (
                    <li class="tool">
                      <BrandIcon tool={t} />
                      <span>{t}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        ))
      }
      <div class="stack__group stack__group--wide" data-rise>
        <h3 class="group-label">Certifications</h3>
        <ul class="tools">
          {
            certifications.map((c) => (
              <li class="tool cred">
                <BrandIcon domain={c.domain} />
                <span>
                  {c.title}
                  <small>{c.year ? `${c.issuer}, ${c.year}` : c.issuer}</small>
                </span>
              </li>
            ))
          }
          <li class="tool cred">
            <span class="brand-icon"><Icon name="languages" size={18} /></span>
            <span>
              Languages
              <small>{languages.join(" and ")}</small>
            </span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
