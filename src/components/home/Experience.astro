---
import Icon from "../Icon.astro";
import { experience, profile } from "../../content/site.js";

const slug = (s) => `role-${s.toLowerCase().replace(/[^a-z]+/g, "-")}`;
const dash = (d) => d.replace(" to ", " – ");
---

<section class="band band--paper band--tight" id="experience" aria-labelledby="experience-title">
  <div class="container journey-grid">
    <div class="story" data-rise>
      <h2 id="experience-title">From Colombo to Vancouver.<br />Still asking better questions.</h2>
      <p>
        I’m Andrew. I started in Colombo’s agency teams after a degree in Management and Digital Innovation. At Kites
        Global I led four client accounts, including Pan Asia Bank and Godrej India: I made the changes in the ad
        accounts week to week and joined the monthly client calls.
      </p>
      <p>
        An MBA brought me to Vancouver. Most recently I ran paid media in-house at Aegon, on a seven-figure annual
        budget for U.S. and Canadian financial products, alongside independent client projects. I’m now looking for
        my next paid media role here, hybrid or on-site.
      </p>
      <p class="story__place">
        <Icon name="pin" size={18} />
        <span>{profile.location}<small>{profile.eligibility}</small></span>
      </p>
      <a class="button button--outline story__cta" href={profile.resume} download data-track="resume_download" data-where="experience">
        The full story, in my résumé <Icon name="arrow-up-right" size={16} />
      </a>
    </div>

    <div class="journey-list" data-rise style="--delay: 120ms">
      <div class="journey-list__head">
        <span class="group-label">The journey so far</span>
        <span class="journey-list__range">2019 – now</span>
      </div>
      <ol>
        {
          experience.map((e) => (
            <li>
              <details class="role" id={slug(e.org)}>
                <summary>
                  <span class="role__date">{dash(e.date)}</span>
                  <span class="role__kind">{e.kind}</span>
                  <h3>
                    {e.org}
                    <span>{e.role}</span>
                  </h3>
                  <span class="role__toggle" aria-hidden="true">
                    <Icon name="plus" size={18} />
                  </span>
                </summary>
                {(e.points.length > 0 || e.clients.length > 0 || e.footnote) && (
                  <div class="role__body">
                    {e.points.length > 0 && (
                      <ul>
                        {e.points.map((p) => (
                          <li>{p}</li>
                        ))}
                      </ul>
                    )}
                    {e.clients.length > 0 && (
                      <ul class="clients" aria-label="Clients">
                        {e.clients.map((c) =>
                          c.href ? (
                            <li>
                              <a class="client-chip" href={c.href} data-track="case_open" data-where="experience">
                                {c.name}
                                <small>{c.detail}</small>
                              </a>
                            </li>
                          ) : (
                            <li class="client-chip">
                              {c.name}
                              <small>{c.detail}</small>
                            </li>
                          ),
                        )}
                      </ul>
                    )}
                    {e.footnote && <p class="fine">{e.footnote}</p>}
                  </div>
                )}
              </details>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
