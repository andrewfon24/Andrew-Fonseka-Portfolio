---
import Icon from "../Icon.astro";
import { testimonials } from "../../content/site.js";

const source = "https://www.linkedin.com/in/andrewfonseka/details/recommendations/";
---

<section class="band band--surface band--tight" id="references" aria-labelledby="references-title">
  <div class="container">
    <div class="refs__head" data-rise>
      <h2 id="references-title">What colleagues say about the work</h2>
      <a class="link" href={source} target="_blank" rel="noreferrer" data-track="linkedin_click" data-where="references">
        Full recommendations on LinkedIn <Icon name="arrow-up-right" size={15} />
      </a>
    </div>
    <div class="refs">
      {
        testimonials.map((t, i) => (
          <figure class="ref" data-rise style={`--delay: ${i * 100}ms`}>
            <span class="ref__label">Excerpt</span>
            <blockquote>“{t.excerpt}”</blockquote>
            <figcaption class="quote__person">
              <span class="avatar" aria-hidden="true">{t.initials}</span>
              <span>
                <strong>{t.name}</strong>
                <span class="quote__role">{t.role}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
