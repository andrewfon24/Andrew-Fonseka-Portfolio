---
// The approach closes the Aegon section: same dark band, a hairline between
// them, four steps in one row. The steps are method only, no figures.
import Icon from "../Icon.astro";
import { approach } from "../../content/site.js";
---

<section class="band band--dark approach" id="approach" aria-labelledby="approach-title">
  <div class="container approach__inner">
    <div class="approach__head" data-rise>
      <h2 id="approach-title">{approach.headline[0]}{" "}<span class="accent">{approach.headline[1]}</span></h2>
      <p>{approach.intro}</p>
    </div>
    <ol class="approach__steps" data-rise style="--delay: 100ms">
      {
        approach.steps.map((s) => (
          <li>
            <span class="approach__num"><Icon name={s.icon} size={20} /></span>
            <span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</section>
