---
import Icon from "./Icon.astro";
import { profile, mailto } from "../content/site.js";
---

<section class="band band--navy contact" id="contact" aria-labelledby="contact-title">
  <div class="container contact__inner" data-rise>
    <h2 id="contact-title">Let’s talk paid media</h2>
    <p class="contact__lede">
      Want to know which of your ads become customers? I can get into the account, explain the recommendation and
      own the follow-through.
      <br />I’d love to hear about your team, agency or in-house.
    </p>
    <div class="contact__actions">
      <a
        class="contact__btn contact__btn--light"
        href={profile.linkedin}
        target="_blank"
        rel="noreferrer"
        data-track="linkedin_click"
        data-where="contact"
      >
        <img src="/images/brands/linkedin-icon.svg" alt="" width="18" height="18" />
        Connect on LinkedIn
      </a>
      <a class="contact__btn" href={mailto} data-track="email_click" data-where="contact">
        <Icon name="mail" size={16} />
        {profile.email}
      </a>
      <a class="contact__btn" href={profile.resume} download data-track="resume_download" data-where="contact">
        <Icon name="file" size={16} />
        Download résumé
      </a>
      <a class="contact__btn" href={profile.portfolio} download data-track="portfolio_download" data-where="contact">
        <Icon name="download" size={16} />
        Portfolio PDF
      </a>
    </div>
    <p class="contact__meta">{profile.location} · Authorized to work in Canada</p>
  </div>
</section>
