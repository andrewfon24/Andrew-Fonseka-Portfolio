---
import Icon from "./Icon.astro";
import { profile, mailto } from "../content/site.js";

const { home = false } = Astro.props;
const links = [
  ["work", "Results"],
  ["approach", "Approach"],
  ["experience", "Experience"],
  ["contact", "Contact"],
];
---

<header class="nav" data-nav>
  <div class="nav__inner container">
    <a class="brand" href="/">
      <img class="brand__face" src="/images/andrew-fonseka-240.webp" alt="" width="40" height="40" />
      <span>Andrew Fonseka<span class="brand__dot">.</span></span>
    </a>
    <nav aria-label="Main navigation">
      <ul class="nav__links">
        {
          links.map(([id, label]) => (
            <li>
              <a href={home || id === "contact" ? `#${id}` : `/#${id}`}>{label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="nav__actions">
      <a
        class="button button--ghost nav__resume"
        href={profile.resume}
        download
        aria-label="Download résumé"
        data-track="resume_download"
        data-where="header"
      >
        <Icon name="download" size={16} />
        <span>Résumé</span>
      </a>
      <a class="button button--primary nav__email" href={mailto} data-track="email_click" data-where="header">
        Email me
      </a>
    </div>
  </div>
</header>
