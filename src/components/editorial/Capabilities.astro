---
const skills = [
  {
    skill: 'Paid search & social',
    title: 'Start with the conversation.',
    body: 'Before I open an ad account, I ask the people who handle enquiries what makes a good one. Their answer shapes the audience I choose, the promise in the ad and the question I put on the form.',
  },
  {
    skill: 'Conversion measurement',
    title: 'Follow a lead past the form.',
    body: 'A form submission is where the customer’s story gets interesting. I trace the tags and CRM stages through to a booked call, an application or a sale. Then I can tell the team which outcome Google or Meta is actually learning from.',
  },
  {
    skill: 'Campaign operations',
    title: 'Leave the team with a better way to work.',
    body: 'When several people have to enter the same campaign name or rebuild the same tracking link, I write a script for it. That leaves the team more time to review the creative, question a budget split and decide what to test next.',
  },
];
---
<section class="working-method wrap" id="capabilities" aria-labelledby="approach-title">
  <header class="method-opening">
    <p class="dateline">My approach</p>
    <h2 id="approach-title">From the client call <em>to the ad account.</em></h2>
    <p class="method-intro">I like being the person who can sit with a client, hear what’s getting in the way, then open the account and do something about it. Here’s how that plays out in my work.</p>
  </header>
  <ol class="method-sequence" role="list">
    {skills.map(step => <li>
      <p class="skill-name">{step.skill}</p>
      <h3>{step.title}</h3>
      <p>{step.body}</p>
    </li>)}
  </ol>
</section>
<style>
  .working-method { padding-block: clamp(44px,6vw,88px); display: grid; grid-template-columns: minmax(0,.88fr) minmax(0,1.12fr); gap: clamp(36px,7vw,100px); align-items: start; border-top: 1px solid var(--line); }
  .method-opening h2 { font: 500 clamp(38px,4.2vw,62px)/1.05 var(--display); letter-spacing: -.05em; margin: 14px 0 22px; }
  .method-opening em { display: block; font-family: Georgia,serif; font-weight: 400; color: #215884; }
  .method-intro { max-width: 38ch; font: 400 clamp(18px,1.4vw,21px)/1.6 var(--text); }
  .method-sequence { margin: 0; padding: 0; list-style: none; }
  .method-sequence li { position: relative; margin-left: 6px; padding: 0 0 28px 28px; border-left: 2px solid #bbcfdf; }
  .method-sequence li:last-child { padding-bottom: 0; border-color: transparent; }
  .method-sequence li::before { content: ''; position: absolute; top: 5px; left: -6px; width: 10px; height: 10px; border: 2px solid var(--blue); border-radius: 50%; background: var(--paper); }
  .method-sequence li:last-child::before { background: var(--blue); }
  .skill-name { font-size: .82rem; font-weight: 600; color: var(--blue); }
  h3 { margin: 4px 0 8px; font: 500 clamp(21px,2vw,27px)/1.2 var(--display); letter-spacing: -.025em; }
  li > p:last-child { max-width: 61ch; line-height: 1.65; }
  @media(max-width: 760px) { .working-method { grid-template-columns: minmax(0,1fr); gap: 32px; } }
</style>
