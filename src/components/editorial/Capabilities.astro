---
import { MessagesSquare, SlidersHorizontal, MousePointer2, PanelsTopLeft, ListFilter, Check, Braces, ClipboardCheck } from 'lucide-react';

const strengths = [
  {
    title: 'Listen to the sales team',
    body: 'I ask which enquiries are worth a follow-up and why. Those conversations shape who I target and what I say in the ad.',
    icon: MessagesSquare, detail: ListFilter,
  },
  {
    title: 'Build the campaign myself',
    body: 'I turn the brief into keywords, audiences and ad copy. Then I follow the click to see whether the landing page delivers on the ad’s promise.',
    icon: PanelsTopLeft, detail: MousePointer2,
  },
  {
    title: 'Teach bidding what counts',
    body: 'I connect CRM stages to Google and Meta so a booked call or completed application can guide the next bid.',
    icon: SlidersHorizontal, detail: Check,
  },
  {
    title: 'Give the team time back',
    body: 'I script the repetitive parts of campaign setup, from naming ads to building tracking links. That leaves more time to review the creative before launch.',
    icon: Braces, detail: ClipboardCheck,
  },
];
---
<section class="working-method wrap chapter" id="capabilities" aria-labelledby="approach-title">
  <header>
    <h2 id="approach-title">How I <span class="chapter-accent">work</span></h2>
    <p class="chapter-intro">My best work starts with a question for the people who speak to customers. What they tell me changes what I build in the account.</p>
  </header>
  <ul class="strengths" role="list">
    {strengths.map(({ title, body, icon: Icon, detail: Detail }) => (
      <li>
        <div class="illustration" aria-hidden="true">
          <span class="drawing"><Icon size={40} strokeWidth={1.6} /></span>
          <span class="detail"><Detail size={19} strokeWidth={2} /></span>
        </div>
        <div><h3>{title}</h3><p>{body}</p></div>
      </li>
    ))}
  </ul>
</section>
<style>
  .working-method header { max-width: 65ch; }
  .strengths {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: clamp(24px, 3vw, 38px) 0 0;
    padding: 0;
    list-style: none;
  }
  .strengths li {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: clamp(18px, 2vw, 28px);
    padding: clamp(22px, 2.6vw, 36px);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: white;
  }
  .working-method .strengths h3 { margin: 0 0 8px; font: 600 clamp(20px, 1.7vw, 25px)/1.18 var(--display); letter-spacing: -.03em; }
  .strengths p { margin: 0; line-height: 1.55; }
  .illustration {
    position: relative;
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    background-color: var(--pale);
    background-image: radial-gradient(#bed1e4 .85px, transparent .95px);
    background-size: 8px 8px;
    border-radius: 16px;
    color: var(--blue);
  }
  .drawing { display: grid; place-items: center; width: 57px; height: 54px; background: white; border: 1.5px solid #9bb7d1; border-radius: 7px; transform: rotate(-5deg); box-shadow: 2px 3px 0 #d2e0ec; }
  .detail { position: absolute; right: 1px; bottom: 4px; display: grid; place-items: center; width: 30px; height: 30px; background: var(--blue); color: white; border: 2px solid white; border-radius: 50%; }
  @media (max-width: 900px) and (min-width: 661px) { .strengths li { grid-template-columns: 1fr; align-content: start; } }
  @media (max-width: 660px) {
    .strengths { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .strengths li { grid-template-columns: 56px 1fr; align-items: start; gap: 15px; padding: 22px 16px; }
    .illustration { transform-origin: top left; transform: scale(.67); margin-bottom: -28px; }
  }
</style>
