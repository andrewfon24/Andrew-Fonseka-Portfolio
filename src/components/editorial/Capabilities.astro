---
import { capabilities } from '../../content/editorial.js';
---
<section class="capabilities section wrap" id="capabilities">
  <div class="section-heading"><h2>What I bring<br class="editorial-only" /> to your team.</h2><p>Those experiences shape how I work today. A clear question, hands-on delivery, and a useful next step.</p></div>
  <div class="capability-list">{capabilities.map(c=><article><h3>{c.title}</h3><p>{c.body}</p><p class="tool-line">{c.tools}</p></article>)}</div>
</section>
