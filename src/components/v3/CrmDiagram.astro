---
// Conceptual CRM and tracking architecture (Aegon case). Original, synthetic
// diagram: no employer systems, payloads or data. The numbered list below the
// drawing is the text equivalent and becomes the diagram on small screens.
const lanes = {
  acq: { name: 'Acquisition', fill: '#eef5fc', stroke: '#2164a9', tag: '#1b548f', title: '#0c2037', sub: '#3d4f63' },
  crm: { name: 'CRM', fill: '#0c2037', stroke: '#0c2037', tag: '#8dbbe8', title: '#ffffff', sub: '#c4d2e1' },
  meas: { name: 'Measurement', fill: '#ffffff', stroke: '#0b6b6a', dash: '7 5', tag: '#0b6b6a', title: '#0c2037', sub: '#3d4f63' },
  feed: { name: 'Feedback', fill: '#2164a9', stroke: '#2164a9', tag: '#d7e6f6', title: '#ffffff', sub: '#e3eefa' },
};
const W = 270, H = 100, L = 50, R = 400, rows = [24, 164, 304, 444];
const nodes = [
  { n: 1, lane: 'acq', x: L, y: rows[0], title: 'Eligible ad platforms', sub: 'Google Ads · Meta · LinkedIn', text: 'Campaigns on Google Ads, Meta and LinkedIn bring people to the site or to a native lead form.' },
  { n: 2, lane: 'acq', x: R, y: rows[0], title: 'Ad click or lead form', sub: 'Landing page or native form', text: 'The visit or form submission starts the journey.' },
  { n: 3, lane: 'crm', x: R, y: rows[1], title: 'Lead capture', sub: 'Qualifying answers · consent', text: 'The form collects qualifying answers and consent, and creates the lead record.' },
  { n: 4, lane: 'crm', x: R, y: rows[2], title: 'HubSpot lead stages', sub: 'Defined stages to application', text: 'Leads move through defined stages, such as qualified, booked call and application.' },
  { n: 5, lane: 'meas', x: L, y: rows[1], title: 'Event collection', sub: 'GA4 · GTM browser + server', text: 'GA4 and Google Tag Manager (browser and server side) record site events and the platform signals each channel supports.' },
  { n: 6, lane: 'meas', x: L, y: rows[2], title: 'Reconcile & validate', sub: 'Event IDs · deduplication', text: 'Event IDs and deduplication keep counts clean. Platform and CRM counts are compared, and gaps are investigated rather than assumed away.' },
  { n: 7, lane: 'feed', x: R, y: rows[3], title: 'Conversion upload', sub: 'Eligible stages, consented data', text: 'Qualifying CRM stages are mapped to conversion actions and shared only with platforms that support it, using consented data under each platform’s rules.' },
  { n: 8, lane: 'feed', x: L, y: rows[3], title: 'Reporting & bidding', sub: 'On platforms, where configured', text: 'Where configured, platforms report and optimize toward those downstream conversions, which shapes the next round of campaigns.' },
];
const cx = (x) => x + W / 2;
const legendOrder = [1, 2, 3, 4, 5, 6, 7, 8].map((n) => nodes.find((d) => d.n === n));
---
<figure class="card arch" aria-labelledby="arch-caption">
  <svg class="arch-svg" viewBox="0 0 700 570" aria-hidden="true" focusable="false">
    <defs>
      <marker id="crm-ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#4a6585" /></marker>
    </defs>
    <g class="arch-edges" stroke="#4a6585" stroke-width="2" fill="none" marker-end="url(#crm-ah)">
      <line x1={L + W} y1={rows[0] + 50} x2={R} y2={rows[0] + 50} />
      <line x1={cx(R)} y1={rows[0] + H} x2={cx(R)} y2={rows[1]} />
      <line x1={R + 24} y1={rows[0] + H} x2={L + W - 24} y2={rows[1]} />
      <line x1={cx(R)} y1={rows[1] + H} x2={cx(R)} y2={rows[2]} />
      <line x1={cx(L)} y1={rows[1] + H} x2={cx(L)} y2={rows[2]} />
      <line x1={R} y1={rows[2] + 50} x2={L + W} y2={rows[2] + 50} />
      <line x1={cx(R)} y1={rows[2] + H} x2={cx(R)} y2={rows[3]} />
      <line x1={R} y1={rows[3] + 50} x2={L + W} y2={rows[3] + 50} />
      <path d={`M${L},${rows[3] + 50} H24 V${rows[0] + 50} H${L}`} stroke-dasharray="6 5" />
    </g>
    <g class="arch-labels">
      <text x={(L + W + R) / 2} y={rows[0] + 40} text-anchor="middle">visit</text>
      <text x={(L + W + R) / 2} y={rows[2] + 40} text-anchor="middle">compare</text>
      <text x={(L + W + R) / 2} y={rows[3] + 40} text-anchor="middle">signals</text>
      <text x="16" y={(rows[0] + rows[3] + H) / 2} text-anchor="middle" transform={`rotate(-90 16 ${(rows[0] + rows[3] + H) / 2})`}>informs the next campaigns</text>
    </g>
    {nodes.map((d) => {
      const s = lanes[d.lane];
      return (
        <g>
          <rect x={d.x} y={d.y} width={W} height={H} rx="14" fill={s.fill} stroke={s.stroke} stroke-width="2" stroke-dasharray={s.dash} />
          <text class="arch-tag" x={d.x + 18} y={d.y + 28} fill={s.tag}>{d.n} · {s.name.toUpperCase()}</text>
          <text class="arch-title" x={d.x + 18} y={d.y + 57} fill={s.title}>{d.title}</text>
          <text class="arch-sub" x={d.x + 18} y={d.y + 81} fill={s.sub}>{d.sub}</text>
        </g>
      );
    })}
  </svg>
  <ol class="arch-legend">
    {legendOrder.map((d) => (
      <li class={`lane-${d.lane}`}>
        <span class="arch-lane">{d.n} · {lanes[d.lane].name}</span>
        <strong>{d.title}</strong>
        <span>{d.text}</span>
      </li>
    ))}
  </ol>
  <figcaption id="arch-caption" class="chart-note">Conceptual representation of the measurement and CRM feedback approach. Exact event paths, consent controls and platform integrations depend on implementation. No employer data shown.</figcaption>
</figure>
