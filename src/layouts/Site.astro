---
import interRegular from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import archivoSemibold from '@fontsource/archivo/files/archivo-latin-600-normal.woff2?url';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/archivo/latin-500.css';
import '@fontsource/archivo/latin-600.css';
import '@fontsource/archivo/latin-700.css';
import '../styles/v3.css';
import Analytics from '@vercel/analytics/astro';
import Icon from '../components/v3/Icon.astro';
import { profile, brand } from '../content/v3.js';
const {
  title = 'Andrew Fonseka | Paid Media Specialist',
  description = 'Paid Media Specialist with agency and in-house experience in CRM-connected measurement, performance optimization and campaign operations. Explore four case studies and contact Andrew about a role.',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/images/andrew-fonseka.jpg', Astro.site).href;
const person = { '@context': 'https://schema.org', '@type': 'Person', name: profile.name, jobTitle: profile.title, url: Astro.site.href, email: profile.email, image: ogImage, sameAs: [profile.linkedin], alumniOf: ['University Canada West', 'University of London'] };
const ga4 = import.meta.env.PUBLIC_GA4_ID;
const nav = [['Results', '/#results'], ['Approach', '/#approach'], ['About', '/#about'], ['References', '/#references'], ['Contact', '#contact']];
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href={interRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={archivoSemibold} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f7faff" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Andrew Fonseka, Paid Media Specialist" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    {ga4 && <><script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`} /><script is:inline define:vars={{ ga4 }}>window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments)};gtag('js',new Date());gtag('config',ga4);</script></>}
    <link rel="icon" href="/favicon.ico?v=headshot-1" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-headshot.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <title>{title}</title>
    <noscript><style>.js-only{display:none}</style></noscript>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="identity" href="/">
          <img src="/images/andrew-fonseka-240.webp" srcset="/images/andrew-fonseka-240.webp 1x, /images/andrew-fonseka-480.webp 2x" width="44" height="44" alt="" />
          <span><strong>Andrew Fonseka</strong><span>Paid Media Specialist</span></span>
        </a>
        <nav class="site-nav" aria-label="Main">
          {nav.map(([label, href]) => <a href={href}>{label}</a>)}
        </nav>
        <a class="pill pill-fill" href={profile.mailto}><Icon name="mail" size={18} />Contact me</a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer id="contact" class="contact">
      <div class="wrap contact-inner">
        <h2>Hiring a Paid Media Specialist?</h2>
        <p>Whether you’re an agency managing client accounts or an in-house team growing your own, I can help connect paid media to the outcomes that matter: qualified leads, applications and sales.</p>
        <div class="actions">
          <a class="pill pill-white" href={profile.mailto}><Icon name="mail" size={18} />Contact me</a>
          <a class="pill pill-ghost" href={profile.resume} target="_blank" rel="noopener"><Icon name="file" size={18} />View résumé (PDF)</a>
          <a class="pill pill-ghost" href={profile.linkedin} target="_blank" rel="noopener"><img src={brand('linkedin-icon')} alt="" width="18" height="18" />Connect on LinkedIn</a>
          <a class="pill pill-ghost" href={profile.portfolio} target="_blank" rel="noopener"><Icon name="download" size={18} />Portfolio (PDF)</a>
        </div>
      </div>
      <div class="footer-bar"><div class="footer-inner"><span>© 2026 Andrew Fonseka</span><span>Paid media, business growth, account ownership</span><a href="#main">Back to top</a></div></div>
    </footer>
    <Analytics />
    <script>
      import { track } from '@vercel/analytics';
      document.addEventListener('click', (event) => {
        const link = (event.target as Element)?.closest?.('a');
        if (!link) return;
        const href = link.getAttribute('href') || '';
        const name = href.startsWith('mailto:') ? 'email_click' : href.includes('/documents/') ? 'document_download' : href.startsWith('/case-studies/') ? 'case_open' : null;
        if (name) { try { track(name, { page: location.pathname, target: href.split('?')[0] }); } catch {} }
      });
    </script>
  </body>
</html>
