---
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/archivo/latin-600.css";
import "@fontsource/archivo/latin-700.css";
import "@fontsource/archivo/latin-800.css";
import "../styles.css";
import "../refinements.css";
const {
  title = "Andrew Fonseka | Paid Media & Performance Marketing",
  description = "Paid Media & Performance Marketing Specialist in Greater Vancouver. Explore campaign results across education, banking, e-commerce and financial services.",
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Andrew Fonseka",
  jobTitle: "Paid Media & Performance Marketing Specialist",
  url: Astro.site.href,
  sameAs: ["https://www.linkedin.com/in/andrewfonseka/"],
  email: "rafandrewf@gmail.com",
  image: new URL("/images/andrew-fonseka.jpg", Astro.site).href,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Greater Vancouver",
    addressRegion: "BC",
    addressCountry: "CA",
  },
};
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#10273f" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={person.image} />
    <meta
      property="og:image:alt"
      content="Andrew Fonseka, Paid Media & Performance Marketing Specialist"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon-portrait.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
