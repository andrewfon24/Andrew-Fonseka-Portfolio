---
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/archivo/latin-600.css";
import "@fontsource/archivo/latin-700.css";
import "@fontsource/archivo/latin-800.css";
import "../styles.css";
import "../refinements.css";
import "../overrides.css";
import "../narrative.css";
import "../rebuild.css";
import Analytics from "@vercel/analytics/astro";
import interRegular from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import archivoBold from "@fontsource/archivo/files/archivo-latin-800-normal.woff2?url";
const {
  title = "Andrew Fonseka | Paid Media & Digital Marketing",
  description = "Vancouver-based paid media and digital marketing practitioner with 3 years across agency, in-house and advisory work. Explore CRM-qualified outcomes across financial services, education and retail.",
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ga4 = import.meta.env.PUBLIC_GA4_ID;
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Andrew Fonseka",
  jobTitle: "Digital Marketing Strategist",
  url: Astro.site.href,
  sameAs: ["https://www.linkedin.com/in/andrewfonseka/"],
  email: "rafandrewf@gmail.com",
  image: new URL("/images/andrew-fonseka.jpg", Astro.site).href,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Greater Vancouver",
    addressRegion: "BC",
    addressCountry: "CA",
  },
};
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="preload"
      href={archivoBold}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={interRegular}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="theme-color" content="#10273f" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={person.image} />
    <meta
      property="og:image:alt"
      content="Andrew Fonseka, paid media and digital marketing"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon-portrait.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    {ga4 && (
      <>
        <script
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}
        />
        <script is:inline define:vars={{ ga4 }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () {
            dataLayer.push(arguments);
          };
          gtag("js", new Date());
          gtag("config", ga4);
        </script>
      </>
    )}
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <Analytics />
    <script>
      import { track } from "@vercel/analytics";
      // One delegated listener for every [data-track] link: résumé and
      // portfolio downloads, email and LinkedIn clicks, case opens.
      document.addEventListener("click", (event) => {
        const el = (event.target as Element)?.closest?.(
          "[data-track]",
        ) as HTMLElement | null;
        if (!el) return;
        const name = el.dataset.track as string;
        const data: Record<string, string> = { page: location.pathname };
        for (const [key, value] of Object.entries(el.dataset)) {
          if (key !== "track" && value) data[key] = value;
        }
        try {
          track(name, data);
        } catch {}
        const gtag = (window as any).gtag;
        if (typeof gtag === "function") gtag("event", name, data);
      });
    </script>
  </body>
</html>
