---
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/inter/latin-700.css";
import "@fontsource/archivo/latin-600.css";
import "@fontsource/archivo/latin-800.css";
import "../styles/site.css";
import Analytics from "@vercel/analytics/astro";
import interRegular from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import archivoBold from "@fontsource/archivo/files/archivo-latin-800-normal.woff2?url";
import Nav from "../components/Nav.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { profile } from "../content/site.js";

const {
  title = "Andrew Fonseka | Paid Media & Performance Marketing Specialist",
  description = "Paid media strategist in Greater Vancouver, available now. Google Ads, Meta, LinkedIn and Microsoft Advertising judged on CRM outcomes: 312 fee-paid enrolments, 259 funded loans, 4:1 first-order ROAS.",
  noindex = false,
  home = false,
  contact = true,
  ogTitle = title,
  ogDescription = description,
  ogImage = "/images/andrew-fonseka.jpg",
  ogImageAlt = "Andrew Fonseka, paid media and performance marketing specialist",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ga4 = import.meta.env.PUBLIC_GA4_ID;
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.title,
  url: Astro.site.href,
  sameAs: [profile.linkedin],
  email: profile.email,
  image: new URL("/images/andrew-fonseka.jpg", Astro.site).href,
  alumniOf: ["University Canada West", "University of London"],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Greater Vancouver",
    addressRegion: "BC",
    addressCountry: "CA",
  },
};
---

<!doctype html>
<html lang="en-CA" id="top">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <link rel="preload" href={archivoBold} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interRegular} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#061224" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon-portrait.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    {
      ga4 && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`} />
          <script is:inline define:vars={{ ga4 }}>
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () {
              dataLayer.push(arguments);
            };
            gtag("js", new Date());
            gtag("config", ga4);
          </script>
        </>
      )
    }
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav home={home} />
    <main id="main">
      <slot />
    </main>
    {contact && <Contact />}
    <Footer />
    <Analytics />
    <script>
      import { initMotion } from "../scripts/motion.js";
      import { track } from "@vercel/analytics";
      initMotion();
      // One delegated listener for every [data-track] link: résumé and
      // portfolio downloads, email and LinkedIn clicks, case opens.
      document.addEventListener("click", (event) => {
        const el = (event.target as Element)?.closest?.("[data-track]") as HTMLElement | null;
        if (!el) return;
        const name = el.dataset.track as string;
        const data: Record<string, string> = { page: location.pathname };
        for (const [key, value] of Object.entries(el.dataset)) {
          if (key !== "track" && value) data[key] = value;
        }
        try {
          track(name, data);
        } catch {}
        const gtag = (window as any).gtag;
        if (typeof gtag === "function") gtag("event", name, data);
      });
    </script>
  </body>
</html>
