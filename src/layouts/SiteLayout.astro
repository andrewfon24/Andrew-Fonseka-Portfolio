---
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/archivo/wdth.css";
import "../site.css";
import Analytics from "@vercel/analytics/astro";

const {
  title = "Andrew Fonseka | Paid Media Specialist, Vancouver",
  description = "Paid media specialist in Greater Vancouver. Google, Meta, LinkedIn and Microsoft Ads optimized to qualified leads, enrolments and funded loans.",
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ga4 = import.meta.env.PUBLIC_GA4_ID;
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Andrew Fonseka",
  jobTitle: "Paid Media Specialist",
  url: Astro.site.href,
  sameAs: ["https://www.linkedin.com/in/andrewfonseka/"],
  email: "rafandrewf@gmail.com",
  image: new URL("/images/andrew-fonseka.jpg", Astro.site).href,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Greater Vancouver",
    addressRegion: "BC",
    addressCountry: "CA",
  },
};
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0c2136" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={person.image} />
    <meta property="og:image:alt" content="Andrew Fonseka, Paid Media Specialist" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    {
      ga4 && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`} />
          <script is:inline define:vars={{ ga4 }}>
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () {
              dataLayer.push(arguments);
            };
            gtag("js", new Date());
            gtag("config", ga4);
          </script>
        </>
      )
    }
    <title>{title}</title>
  </head>
  <body id="top">
    <slot />
    <Analytics />
    <script>
      import { track } from "@vercel/analytics";
      // One listener for every [data-track] link or button: resume downloads,
      // email and LinkedIn clicks, case opens, question opens.
      document.addEventListener("click", (event) => {
        const el = (event.target as Element)?.closest?.("[data-track]") as HTMLElement | null;
        if (!el) return;
        const name = el.dataset.track as string;
        const data: Record<string, string> = { page: location.pathname };
        for (const [key, value] of Object.entries(el.dataset)) {
          if (key !== "track" && value) data[key] = value;
        }
        try {
          track(name, data);
        } catch {}
        const gtag = (window as any).gtag;
        if (typeof gtag === "function") gtag("event", name, data);
      });
    </script>
  </body>
</html>
