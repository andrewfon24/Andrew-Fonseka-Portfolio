---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/archivo/latin-400.css';
import '@fontsource/archivo/latin-500.css';
import '@fontsource/archivo/latin-600.css';
import '@fontsource/archivo/latin-700.css';
import '../styles/preview.css';
import '../styles/editorial.css';
import Analytics from '@vercel/analytics/astro';
import ActionIcon from '../components/editorial/ActionIcon.astro';
import { profile, mailto } from '../content/editorial.js';
const { direction = 'editorial', title = 'Andrew Fonseka — Paid Media Specialist', home = false } = Astro.props;
const base = '/';
const { description = 'Andrew Fonseka, Paid Media Specialist. Hands-on campaigns, CRM measurement and commercial judgement. Greater Vancouver and remote across Canada.', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/images/andrew-fonseka.jpg', Astro.site).href;
const person = { '@context':'https://schema.org', '@type':'Person', name:profile.name, jobTitle:profile.title, url:Astro.site.href, email:profile.email, image:ogImage, sameAs:[profile.linkedin], alumniOf:['University Canada West','University of London'], address:{'@type':'PostalAddress',addressLocality:'Greater Vancouver',addressRegion:'BC',addressCountry:'CA'} };
const ga4 = import.meta.env.PUBLIC_GA4_ID;
---
<!doctype html>
<html lang="en-CA" class:list={[{ "editorial-root": direction === "editorial" }]} >
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f7faff" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Andrew Fonseka, Paid Media Specialist" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    {ga4 && <><script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`} /><script is:inline define:vars={{ga4}}>window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments)};gtag('js',new Date());gtag('config',ga4);</script></>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body class:list={[direction, { 'home-page': home }]}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="identity" href={base}>{direction === "editorial" && <span class="monogram" aria-hidden="true">AF</span>}<span class="identity-copy"><strong>Andrew Fonseka</strong><span>Paid Media Specialist</span></span></a>
      <nav aria-label="Main navigation">
        <a href={`${base}#work`}>{direction === "editorial" ? "Results" : "Selected work"}</a>
        {direction === "editorial" && <a href={`${base}#capabilities`}>Approach</a>}
        <a href={`${base}#about`}>About</a>
        <a href={`${base}#contact`}>Contact</a>
      </nav>
      {direction === "editorial" && <a class="button nav-email" href={mailto}><ActionIcon name="mail" />Email me</a>}
    </header>
    <main id="main"><slot /></main>
    {direction === "editorial" && <div class="contact-band"><section id="contact" class="contact-centered wrap" aria-labelledby="contact-title"><h2 id="contact-title">Let’s talk paid media</h2><p>Want to know which of your ads become customers? I can get into the account,<br class="contact-break" /> explain the recommendation and own the follow-through.<br />I’d love to hear about your team, agency or in-house.</p><div class="contact-buttons"><a class="contact-button contact-primary" href={mailto}><ActionIcon name="mail" />{profile.email}</a><a class="contact-button" href={profile.linkedin} target="_blank" rel="noopener"><img src="/images/brands/linkedin-icon.svg" alt="" width="18" height="18" />Connect on LinkedIn</a><a class="contact-button" href={profile.resume} download><ActionIcon name="file" />Download résumé</a><a class="contact-button" href={profile.portfolio} download><ActionIcon name="download" />Portfolio PDF</a></div><p class="contact-meta">Greater Vancouver, BC · Remote within Canada · Authorized to work in Canada</p></section><footer class="navy-footer"><span>© 2026 Andrew Fonseka</span><span>Paid media · Business growth · Account ownership</span><a href={base}>Back to top ↑</a></footer></div>}
    <Analytics />
    <script>
      import { track } from '@vercel/analytics';
      document.addEventListener('click', event => {
        const link=(event.target as Element)?.closest?.('a');
        if(!link)return;
        const href=link.getAttribute('href')||'';
        const name=href.startsWith('mailto:')?'email_click':href.includes('/documents/')?'document_download':href.startsWith('/case-studies/')?'case_open':null;
        if(name) { try { track(name,{page:location.pathname,target:href.split('?')[0]}); } catch {} }
      });
    </script>
  </body>
</html>
