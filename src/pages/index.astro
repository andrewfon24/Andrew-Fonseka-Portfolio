---
import EditorialLayout from '../layouts/EditorialLayout.astro';
import ActionIcon from '../components/editorial/ActionIcon.astro';
import Evidence from '../components/editorial/Evidence.astro';
import TechStack from '../components/editorial/TechStack.astro';
import Capabilities from '../components/editorial/Capabilities.astro';
import CareerTimeline from '../components/editorial/CareerTimeline.astro';
import CampaignFigure from '../components/editorial/CampaignFigure.astro';
import { profile, mailto, testimonials } from '../content/editorial.js';
const caseUrl = (id) => `/case-studies/${id}/`;
const recommendations = [testimonials[1], testimonials[2], testimonials[0]];
---
<EditorialLayout home>
  <section class="hero wrap" aria-labelledby="intro-title">
    <div class="hero-copy">
      <h1 id="intro-title">I’m Andrew.<br />I like knowing<br /><span>what happens next.</span></h1>
      <p class="intro">Someone clicks an ad. Did they enrol, take out a loan, or place their first order? I’m a paid media specialist who follows those decisions from the ad account into the client’s sales records.</p>
      <p class="hero-detail">I plan and run paid search and social campaigns, build conversion tracking, and use CRM data and sales feedback to decide where the next dollar goes.</p>
      <div class="hero-actions"><a class="button" href={mailto}>Email me about a role <ActionIcon name="arrow" /></a><a class="text-link" href={profile.resume} target="_blank" rel="noopener"><ActionIcon name="file" />View résumé</a></div>
      <p class="availability">Available now for hybrid or remote roles in Greater Vancouver</p>
    </div>
    <figure class="portrait-block"><img src="/images/andrew-fonseka-480.webp" srcset="/images/andrew-fonseka-480.webp 480w, /images/andrew-fonseka-720.webp 720w" sizes="(max-width: 380px) calc(100vw - 32px), (max-width: 760px) 300px, (max-width: 1000px) 28vw, 360px" width="480" height="480" alt="Andrew Fonseka, Paid Media Specialist" fetchpriority="high" /><figcaption><strong>Andrew Fonseka</strong><span>Agency experience. In-house perspective.</span><span>Greater Vancouver, BC</span></figcaption></figure>
  </section>
  <div class="proof-strip proof-strip--budget wrap" aria-label="Advertising budget and selected campaign outcomes">
    <a href={caseUrl('aegon')}><strong>Seven-figure</strong><span>annual ad budget<small>Aegon · co-managed with the team</small></span></a>
    <a href={caseUrl('university')}><strong>312</strong><span>fee-paid enrolments<small>Private university · CRM-matched</small></span></a>
    <a href={caseUrl('panasia')}><strong>259</strong><span>funded loans<small>Pan Asia Bank · client-reported</small></span></a>
    <a href={caseUrl('petmart')}><strong>4:1</strong><span>first-order ROAS<small>Petmart.lk · client-reported</small></span></a>
  </div>
  <section id="work" class="selected section wrap" aria-labelledby="work-title">
    <div class="section-heading work-heading"><h2 id="work-title">The work that<br /><span>shaped my thinking.</span></h2><p>Three accounts, three decisions. Here’s what I worked on and how each team measured the result.</p></div>
    <article class="featured">
      <div class="featured-copy">
        <div class="case-meta"><span>Private university, Saudi Arabia</span><span>May–Aug 2026</span></div>
        <h3>Two colleges still <span>had seats to fill.</span></h3>
        <p>Admissions needed students for two specific colleges. I recommended a dedicated budget and helped the partner agency build and manage a higher-intent Meta campaign.</p>
        <div class="feature-result"><strong>125</strong><span>fee-paid enrolments at the two colleges from the dedicated campaign<small>312 across all three campaigns · University admissions CRM</small></span></div>
        <a class="case-button" href={caseUrl('university')} aria-label="Read the case study for Private university">Read the case study <ActionIcon name="arrow" /></a>
      </div>
      <div class="university-proof"><CampaignFigure campaign="university" /><Evidence /></div>
    </article>
    <div class="supporting-work case-grid">
      <article class="case-card">
        <div class="case-meta"><span>Pan Asia Bank</span><span>Agency · Kites Global</span></div>
        <h3>Which enquiries became loans?</h3>
        <p>I led the Gold2Cash account and used the bank’s sales feedback to split a US$25,000 budget between Meta and Google.</p>
        <div class="card-result"><strong>259 funded loans</strong><span>Reported by the bank · About US$97 in media per funded loan</span></div>
        <a class="case-button" href={caseUrl('panasia')} aria-label="Read the case study for Pan Asia Bank">Read the case study <ActionIcon name="arrow" /></a>
      </article>
      <article class="case-card">
        <div class="case-meta"><span>Aegon</span><span>In-house · Financial services</span></div>
        <h3>What could the team safely automate?</h3>
        <p>I wrote a campaign builder that turned a single brief into tracking links, ad drafts and variants for compliance review.</p>
        <div class="card-result"><strong>~200 campaigns launched</strong><span>22 colleagues used the builder · Estimated 12 working days saved per year</span></div>
        <a class="case-button" href={caseUrl('aegon')} aria-label="Read the case study for Aegon">Read the case study <ActionIcon name="arrow" /></a>
      </article>
    </div>
  </section>

  <Capabilities />

  <section id="about" class="wrap chapter two-column" aria-labelledby="about-title">
    <div><h2 id="about-title">About <span class="chapter-accent">Andrew</span></h2>
      <p class="chapter-intro">I love the moment a client tells me what happened after a campaign went live. At Kites Global in Colombo, a conversation with a bank’s sales team helped me decide where to spend its next ad dollar.</p>
      <p>I started in paid media at Enfection, learning how to run campaigns across three markets. At Kites Global, I managed four accounts of my own. I liked being able to make a change in the ad account, then sit down with the client and explain why I’d made it.</p>
      <p>After my MBA at University Canada West, I joined Aegon in Langley. Co-managing a seven-figure annual budget meant thinking about the people launching campaigns alongside me. I wrote a tool that 22 colleagues used to turn a brief into a campaign ready for review.</p>
      <p>I’m excited to bring both experiences to my next paid media role. I enjoy owning an account, making a recommendation I can explain, and hearing from the people who see what happens next.</p>
      <div class="story-links"><a class="text-link" href={profile.resume}>Read my résumé (PDF)</a><a class="text-link" href={profile.portfolio}>View the portfolio (PDF)</a></div>
    </div><CareerTimeline />
  </section>

  <TechStack />

  <section class="wrap recommendations chapter" aria-labelledby="recommendations-title">
    <h2 id="recommendations-title">What it’s like to <em>work with me.</em></h2>
    <div class="recommendation-grid">{recommendations.map((t, i)=><figure class:list={["recommendation-card", {"recommendation-featured": i === 0}]} >
      <blockquote><p>“{t.excerpt}”</p></blockquote><figcaption><span class="recommendation-initials" aria-hidden="true">{t.initials}</span><div><strong>{t.name}</strong><span>{t.role}</span></div></figcaption>
      <details><summary>Full recommendation</summary><p>“{t.quote}”</p></details>
    </figure>)}</div>
    <a class="text-link" href={profile.linkedin + 'details/recommendations/'}>Recommendations on LinkedIn <ActionIcon name="arrow" /></a>
  </section>
</EditorialLayout>
<style is:global>
.editorial .proof-strip--budget { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:0; padding-block:32px; }
.editorial .proof-strip--budget a { display:flex; flex-direction:column; align-items:flex-start; justify-content:flex-start; gap:14px; min-width:0; padding:0 24px; border:0; border-right:1px solid var(--line); }
.editorial .proof-strip--budget a:first-child { padding-left:0; }
.editorial .proof-strip--budget a:last-child { padding-right:0; border-right:0; }
.editorial .proof-strip--budget strong { display:block; font-size:clamp(28px,2.75vw,40px); line-height:1.2; white-space:nowrap; }
.editorial .proof-strip--budget span { display:block; font-size:16px; line-height:1.5; }
.editorial .proof-strip--budget small { display:block; font-size:12px; line-height:1.6; margin-top:6px; }
@media(max-width:1100px) and (min-width:761px) {
 .editorial .proof-strip--budget { grid-template-columns:repeat(2,minmax(0,1fr)); padding-block:0; }
 .editorial .proof-strip--budget a { padding:24px; border:0; }
 .editorial .proof-strip--budget a:nth-child(odd) { padding-left:0; border-right:1px solid var(--line); }
 .editorial .proof-strip--budget a:nth-child(-n+2) { border-bottom:1px solid var(--line); }
 .editorial .proof-strip--budget strong { font-size:38px; }
}
@media(max-width:760px) {
 .editorial .proof-strip--budget { grid-template-columns:1fr; padding-block:0; }
 .editorial .proof-strip--budget a, .editorial .proof-strip--budget a:first-child, .editorial .proof-strip--budget a:last-child { display:flex; flex-direction:column; gap:8px; padding:24px 0; border:0; border-bottom:1px solid var(--line); }
 .editorial .proof-strip--budget a:last-child { border-bottom:0; }
 .editorial .proof-strip--budget strong { font-size:38px; }
}
</style>
