---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Icon from "../../components/Icon.astro";
import Figure from "../../components/Figure.astro";
import Bars from "../../components/charts/Bars.astro";
import Columns from "../../components/charts/Columns.astro";
import Split from "../../components/charts/Split.astro";
import Systems from "../../components/home/Systems.astro";
import FunnelCrmDemo from "../../islands/FunnelCrmDemo.tsx";
import CampaignExplorer from "../../islands/CampaignExplorer.tsx";
import { cases, university, aegon } from "../../content/site.js";

export function getStaticPaths() {
  return cases.map((c, i) => ({
    params: { slug: c.id },
    props: { c, next: cases[(i + 1) % cases.length] },
  }));
}

const { c, next } = Astro.props;
const isAegon = c.id === "aegon";
const title = isAegon
  ? "Aegon: paid media automation and CRM measurement | Andrew Fonseka"
  : `${c.clientShort ?? c.client} case study | Andrew Fonseka`;
const ogExtras = isAegon
  ? {
      ogImage: "/images/measurement-automation.png",
      ogImageAlt: "Illustrative workflow connecting paid media, conversion tracking, CRM signals, automation and reporting.",
    }
  : {};
---

<SiteLayout title={title} description={c.summary} {...ogExtras}>
  <section class="band band--dark case-hero" aria-labelledby="case-title">
    <div class="container">
      <a class="crumb" href="/#work"><Icon name="arrow-left" size={16} />All work</a>
      <ul class="chips" aria-label="Context">
        <li class="chip">{c.clientShort ?? c.client}</li>
        <li class="chip">{c.sector}</li>
        <li class="chip">{c.context}</li>
        <li class="chip">{c.period}</li>
      </ul>
      <h1 id="case-title">{c.headline[0]}{" "}<span class="accent">{c.headline[1]}</span></h1>
      <p class="case-hero__summary">{c.summary}</p>
      {
        c.stats && (
          <div class="case-stats" style={`--n: ${c.stats.length}`}>
            {c.stats.map((s, i) => (
              <div class="case-stat" data-rise style={`--delay: ${i * 90}ms`}>
                <Figure dark value={s.value} count={s.count} prefix={s.prefix} suffix={s.suffix} />
                <span class="stat__label">{s.label}</span>
                {s.sub && <span class="stat__sub">{s.sub}</span>}
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>

  {
    isAegon ? (
      <>
        <Systems showLink={false} headingLevel={2} title={["How a campaign", "goes live."]} />
        <section class="band band--paper" aria-labelledby="aegon-detail">
          <div class="container">
            <div class="head" data-rise>
              <h2 id="aegon-detail">What I built <span class="accent">behind the campaigns.</span></h2>
              <p>{c.role}</p>
            </div>
            <ul class="systems-list" style="margin-top: 0">
              {aegon.systems.map((s, i) => (
                <li data-rise style={`--delay: ${i * 70}ms; border-color: var(--color-rule)`}>
                  <span class="approach__num"><Icon name={s.icon} size={20} /></span>
                  <span>
                    <h3>{s.title}</h3>
                    <p>{s.body}</p>
                  </span>
                </li>
              ))}
            </ul>
            <div class="journey" data-rise>
              <h3 class="journey__title" id="journey-title">Investor journey: the LinkedIn account-based program</h3>
              <ol class="journey__steps" aria-labelledby="journey-title">
                {aegon.journey.map((j) => (
                  <li>
                    <b>{j.title}</b>
                    <span>{j.body}</span>
                  </li>
                ))}
              </ol>
            </div>
            <p class="fine sources">{c.note} Performance figures withheld at the employer’s request.</p>
          </div>
        </section>
      </>
    ) : (
      <section class="band band--paper" aria-label="Brief and evidence">
        <div class="container brief">
          <aside class="brief__notes" data-rise>
            <div>
              <h2>Problem</h2>
              <p>{c.problem}</p>
            </div>
            <div>
              <h2>{c.decisionLabel ?? "Decision"}</h2>
              <p>{c.decision}</p>
            </div>
            <div>
              <h2>My role</h2>
              <p>{c.role}</p>
            </div>
          </aside>

          <div class="brief__evidence">
            {c.id === "university" && (
              <>
                <div class="panel" data-rise>
                  <h3>From Meta lead to fee-paid enrolment</h3>
                  <p class="panel__sub">{university.window}, {university.spend}</p>
                  <Bars
                    rows={university.funnel.map((r, i) => ({ ...r, tone: i === 2 ? "gold" : undefined }))}
                    label="821 Meta leads, 430 CRM-qualified, 312 fee-paid enrolments"
                    stagger={200}
                  />
                  <p class="fine" style="margin-top: var(--space-4)">{university.matchNote}</p>
                </div>
                <div class="demo" data-rise>
                  <div aria-hidden="true" data-ss-fill>
                    <FunnelCrmDemo client:visible />
                  </div>
                  <div class="demo__label"><span class="fine">Illustrative CRM view of the same funnel. No student data.</span></div>
                </div>
              </>
            )}

            {c.id === "panasia" && (
              <>
                <div class="panel" data-rise>
                  <h3>Budget allocation</h3>
                  <p class="panel__sub">US$25,000 total media budget</p>
                  <Split />
                </div>
                <div class="equation" data-rise role="img" aria-label="US$25,000 media budget divided by 259 funded loans equals US$96.53 per funded loan, about US$97">
                  <span aria-hidden="true"><b class="equation__gold">US$25,000</b>media budget</span>
                  <span class="equation__op" aria-hidden="true">÷</span>
                  <span aria-hidden="true"><b>259</b>funded loans</span>
                  <span class="equation__op" aria-hidden="true">=</span>
                  <span aria-hidden="true"><b class="equation__gold">US$96.53</b>per funded loan, about US$97</span>
                </div>
              </>
            )}

            {c.id === "petmart" && (
              <>
                <div class="panel charts-pair" data-rise>
                  <div>
                    <div class="chart-title"><strong>Indexed change</strong><span>Before = 100</span></div>
                    <Columns
                      label="Indexed change: sales 100 before, 140 after; subscriptions 100 before, 130 after"
                      bars={[
                        { label: "Sales before", value: 100, tone: "soft" },
                        { label: "Sales after", value: 140 },
                        { label: "Subs. before", value: 100, tone: "soft" },
                        { label: "Subs. after", value: 130 },
                      ]}
                    />
                  </div>
                  <div>
                    <div class="chart-title"><strong>Spend and revenue</strong><span>US$, client-reported</span></div>
                    <Columns
                      label="US$5K ad spend against US$50K quarterly revenue"
                      bars={[
                        { label: "Ad spend", value: 5, display: "US$5K", tone: "navy" },
                        { label: "Quarterly revenue", value: 50, display: "US$50K", tone: "gold" },
                      ]}
                    />
                  </div>
                </div>
                <figure class="creative" data-rise style="max-width: 22rem">
                  <img src="/images/petmart-valentines.jpg" alt="Petmart and Sugar Beach Valentine’s Day activation creative" loading="lazy" width="864" height="1080" />
                  <figcaption>Valentine’s Day activation creative, Petmart and Sugar Beach</figcaption>
                </figure>
              </>
            )}

            {c.id === "dats" && (
              <>
                <div class="panel" data-rise>
                  <h3>CRM-qualified leads per quarter</h3>
                  <p class="panel__sub">Raw counts, client-reported</p>
                  <div class="callout">
                    <Columns
                      label="178 CRM-qualified leads in the prior quarter, 212 in March to May 2026"
                      bars={[
                        { label: "Prior quarter", value: 178, tone: "soft" },
                        { label: "Mar to May 2026", value: 212, tone: "gold" },
                      ]}
                    />
                    <div>
                      <Figure value="+19%" count={19} prefix="+" suffix="%" />
                      <p class="stat__label">178 to 212 at the same budget</p>
                    </div>
                  </div>
                </div>
                <ol class="steps-inline" data-rise>
                  {c.actions.map((a, i) => (
                    <li>
                      <b>0{i + 1}</b>
                      {a}
                    </li>
                  ))}
                </ol>
              </>
            )}
          </div>
        </div>
      </section>
    )
  }

  {
    c.id === "university" && (
      <section class="band band--surface" aria-labelledby="compare-title">
        <div class="container">
          <div class="head" data-rise>
            <h2 id="compare-title">The blended average <span class="accent">hid the decision.</span></h2>
          </div>
          <CampaignExplorer client:visible campaigns={university.campaigns} blended={university.blended} />
          <div class="callout-row">
            <div class="panel callout" data-rise>
              <p class="callout__big">125 <span>vs</span> 17</p>
              <p>Enrolments for the two priority colleges: dedicated campaign vs the broad campaign.</p>
            </div>
            <div class="panel" data-rise>
              <p><strong style="color: var(--color-ink)">The trade-off.</strong> {university.tradeoff}</p>
            </div>
          </div>
          <div class="sources fine">
            <p>{university.matchNote}</p>
            <p>{university.totalsNote}</p>
            <p>{c.note}</p>
          </div>
        </div>
      </section>
    )
  }

  {
    !isAegon && c.id !== "university" && (
      <section class="band band--paper" style="padding-top: 0" aria-label="Sources">
        <div class="container">
          <p class="fine sources" style="margin-top: 0">{c.note}</p>
        </div>
      </section>
    )
  }

  <section class={`band ${c.id === "university" ? "band--surface" : "band--paper"} band--tight`} style="padding-top: 0" aria-label="Next case study">
    <div class="container">
      <a class="next-case" href={`/case-studies/${next.id}/`} data-track="case_open" data-case={next.id} data-where="next">
        <span>
          <span class="fine">Next case study</span>
          <strong>{next.headline[0]} {next.headline[1]}</strong>
        </span>
        <Icon name="arrow-right" size={24} />
      </a>
    </div>
  </section>
</SiteLayout>
