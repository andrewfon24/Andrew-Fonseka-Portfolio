---
import PreviewLayout from '../../layouts/EditorialLayout.astro';
import ActionIcon from '../../components/editorial/ActionIcon.astro';
import Evidence from '../../components/editorial/Evidence.astro';
import { stories } from '../../content/stories.js';
import { cases, builder, aegon } from '../../content/editorial.js';
export function getStaticPaths() {
  return cases.map(c => ({params:{slug:c.id},props:{c}}));
}
const direction = 'editorial';
const { c } = Astro.props;
const story = stories[c.id];
const isAegon = c.id === 'aegon';
const isUniversity = c.id === 'university';
// Do not repeat the existing source's all-prospecting claim: the attached export
// explicitly labels one campaign Retargeting, and flight names are not dates.
const limits = (c.limits || []).filter(item => !item.includes('prospecting audiences'));
---
<PreviewLayout direction={direction} title={`${c.clientShort || c.client} — Andrew Fonseka`} description={story.intro}>
  <article class="case-page wrap">
    <a class="back-link" href={'/#work'}>← Back to selected work</a>
    <h1>{story.title[0]} <span>{story.title[1]}</span></h1>
    <div class="case-meta"><span>{c.clientShort || c.client}</span><span>{c.context}</span><span>{c.period}</span></div>
    <p class="case-lede">{story.intro}</p>
    {c.stats && <div class="case-numbers">{c.stats.map(s=><div><strong>{s.value}</strong><span>{s.label}</span>{s.sub && <small>{s.sub}</small>}</div>)}</div>}
    <div class="case-body">
      <div class="case-narrative">
        <section><h2>{story.beginning}</h2><p>{story.problem}</p></section>
        <section><h2>{story.turn}</h2><p>{story.decision}</p></section>
        {isUniversity && <section><h2>A shared effort, with clear responsibilities.</h2><p>The partner agency handled day-to-day optimisation. The university and partner agency matched leads to fee-paid enrolments and reported the admissions outcomes.</p></section>}
        {isUniversity && <section><h2>The tradeoff behind the result.</h2><p style="margin-top:14px">The priority campaign’s US$28 cost per enrolment was higher than the broad campaign’s US$13. It addressed a different need: filling the two colleges with the weakest intake.</p></section>}

        <section><h2>{story.outcome}</h2><p>{story.result}</p></section>
        {isAegon && <section><h2>How it was validated</h2><p>{builder.steps[3].body}</p><p style="margin-top:14px">Legal and compliance retained final approval of each launch. The tool supported their review; it did not replace it.</p></section>}
        {c.id === 'petmart' && <section><h2>Reading the result</h2><p>The 4:1 result describes first-order return on ad spend for Shopping and Performance Max. It excludes customer lifetime value and does not establish incremental profit.</p></section>}
        {c.id === 'panasia' && <section><h2>Reading the result</h2><p>The bank reported 259 funded gold loans. The US$500K is principal lent, not bank revenue or profit. Channel-level funded-loan counts were not available.</p></section>}
        <section class="story-takeaway"><h2>What I take from this.</h2><p>{story.takeaway}</p></section>
      </div>
      <aside class="case-side" aria-label="Evidence and interpretation">
        {isUniversity && <Evidence full />}
        {isAegon && <><h2>Inside the operating process</h2><ol class="process-list">{aegon.systems.filter(s=>['Automation','Tracking rebuild','Budget pacing'].includes(s.title)).map(s=><li><h3>{s.title}</h3><p>{s.body}</p></li>)}</ol></>}
        <div class="limits"><h2>{isAegon ? 'Confidentiality' : 'Sources & limits'}</h2><p>{c.note}</p>{limits.length>0 && <ul>{limits.map(l=><li>{l}</li>)}</ul>}</div>
      </aside>
    </div>
    {isUniversity && <details class="source-image"><summary>Inspect the Meta Ads Manager evidence</summary><p>Owner-supplied export for 1 May–31 August 2026: 821 leads and SAR 23,421.20 spent. This screenshot supports ad-platform leads and spend. The enrolment figures come separately from the admissions CRM reporting in the portfolio.</p><p>Month labels in campaign names are not verified flight dates. View the complete export below, or <a href="/evidence/meta-ads-may-aug-2026.png" target="_blank" rel="noopener">open the full-resolution screenshot ↗</a>.</p><div class="image-scroll"><img src="/evidence/meta-ads-may-aug-2026.png" alt="Meta Ads Manager, 1 May to 31 August 2026. Priority colleges: 161 leads, SAR 13,152.79 spent. Retargeting: 57 leads, SAR 2,383.93. Broad undergraduate: 603 leads, SAR 7,884.48. Total: 821 leads, SAR 23,421.20." width="2048" height="369" loading="lazy" /></div></details>}
    <div class="case-next"><a class="text-link" href={'/#work'}>Explore the other case studies <ActionIcon name="arrow" /></a></div>
  </article>
</PreviewLayout>
