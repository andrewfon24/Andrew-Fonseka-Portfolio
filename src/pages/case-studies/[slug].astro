---
import Site from '../../layouts/Site.astro';
import Icon from '../../components/v3/Icon.astro';
import { stories } from '../../content/v3.js';
export function getStaticPaths() {
  return stories.map((s) => ({ params: { slug: s.id }, props: { s } }));
}
const { s } = Astro.props;
const next = s.next && stories.find((x) => x.id === s.next.id);
const id = s.id;
---
<Site title={`${s.short}: ${s.title} | Andrew Fonseka`} description={s.description}>
  <div class="wrap case-top">
    <a class="pill pill-quiet" href="/#results"><Icon name="back" size={18} />All results</a>
  </div>
  <div class="wrap case-layout">
    <article class="case-article">
      <header>
        <span class="chapter">Case study {s.number} of 4, {s.short}</span>
        <h1>{s.title}</h1>
        <p class="case-lede">{s.lede}</p>
        <p class="meta">{s.meta}</p>
      </header>

      {id === 'aegon' && (
        <>
          <section class="case-section" aria-labelledby="c1">
            <h2 id="c1"><span class="n">1</span>Problem</h2>
            <p>50+ insurance and investment products, 20 to 25 live campaigns and three platforms, each counting leads its own way, so totals didn’t line up with HubSpot. The goal was leads that become applicants, not just form fills.</p>
          </section>
          <section class="case-section" aria-labelledby="c2">
            <h2 id="c2"><span class="n">2</span>What I built</h2>
            <div class="flow">
              <div class="flow-box"><strong>Fix tracking</strong>GA4, server-side GTM, Enhanced Conversions, Meta CAPI. March to May 2026.</div>
              <span class="flow-arrow" aria-hidden="true"><Icon name="arrow" size={16} /></span>
              <div class="flow-box"><strong>Connect the CRM</strong>HubSpot stages (qualified lead, booked call, application) and their values fed value-based bidding; tested with Meta Conversion Lift.</div>
              <span class="flow-arrow" aria-hidden="true"><Icon name="arrow" size={16} /></span>
              <div class="flow-box is-blue"><strong>Fix the leads</strong>A/B-tested forms, a new post-submit page, no Meta Audience Network. June 2026.</div>
            </div>
            <figure class="card loop-figure" aria-label="The CRM-to-bidding loop" style="margin:0">
              <div class="flow">
                <div class="flow-box"><strong>Ad</strong>Google, Meta, LinkedIn</div>
                <span class="flow-arrow" aria-hidden="true"><Icon name="arrow" size={16} /></span>
                <div class="flow-box"><strong>Lead</strong>Form with qualifying questions</div>
                <span class="flow-arrow" aria-hidden="true"><Icon name="arrow" size={16} /></span>
                <div class="flow-box is-blue"><strong>HubSpot</strong>Qualified, booked call, application</div>
              </div>
              <div class="loop-return" aria-hidden="true"></div>
              <figcaption>Lead stages return to each platform as offline conversions, so bidding looks for people who resemble applicants</figcaption>
            </figure>
            <figure class="card case-figure">
              <figcaption class="chart-title">Meta Event Match Quality, out of 10</figcaption>
              <div class="bar-row"><span>Before the rebuild</span><span class="bar-track"><span class="bar" style="width:55%"></span><strong class="num">5.5</strong></span></div>
              <div class="bar-row"><span>After</span><span class="bar-track"><span class="bar bar-blue" style="width:70%"></span><strong class="num">7.0</strong></span></div>
              <p class="chart-note">Platform conversions now reconcile with HubSpot.</p>
            </figure>
          </section>
          <section class="case-section" aria-labelledby="c3">
            <h2 id="c3"><span class="n">3</span>What moved</h2>
            <div class="tiles">
              <div class="tile is-lead"><span class="stat-value num">−15%</span><small>cost per lead at flat spend</small></div>
              <div class="card tile"><span class="stat-value num">+17 pts</span><small>qualified lead rate</small></div>
              <div class="card tile"><span class="stat-value num">+22%</span><small>applications</small></div>
              <div class="card tile"><span class="stat-value num">2×</span><small>qualified-lead rate of the A/B test winner</small></div>
            </div>
            <figure class="card case-figure">
              <figcaption class="chart-title">Cost per lead, indexed (H2 2025 = 100)</figcaption>
              <div class="bar-row"><span>H2 2025, old form</span><span class="bar-track"><span class="bar" style="width:88%"></span><strong class="num">100</strong></span></div>
              <div class="bar-row"><span>H1 2026, new form</span><span class="bar-track"><span class="bar bar-blue" style="width:75%"></span><strong class="num">85</strong></span></div>
              <p class="chart-note">H2 2025 to H1 2026. Same spend in both halves. Both halves de-duplicated and measured the same way.</p>
            </figure>
          </section>
          <section class="case-section" aria-labelledby="c-builder">
            <h2 id="c-builder">The campaign builder 22 colleagues used</h2>
            <p>Hand-built launches meant inconsistent names and UTMs, and slow manual compliance checks. I built a Google Apps Script campaign builder with AI-assisted coding, linked to Google Ads and Sheets via API. It turns one brief into naming, UTMs and A/B variants, then runs Quebec and U.S. compliance checks that the launcher and compliance sign off. I trained 22 colleagues to use it, and compliance rejections nearly disappeared.</p>
            <div class="builder">
              <figure class="card case-figure">
                <span class="meta">Mock with dummy fields. Built with AI-assisted coding, linked to Google Ads and Sheets via API</span>
                <div class="mock">
                  <span>Product<span>Sample Product A</span></span>
                  <span>Market<span>Region X</span></span>
                  <span>Campaign name<span>PRD-A_REG-X_LEAD_2026</span></span>
                  <span>UTM source / medium<span>platform / paid</span></span>
                </div>
                <figcaption style="color:var(--blue-ink);font-weight:500;font-size:14px">Naming valid. Two A/B variants built. Compliance check signed off by the launcher and compliance.</figcaption>
              </figure>
              <div class="builder-stats">
                <div class="card"><span class="stat-value num">22</span>colleagues used it</div>
                <div class="card"><span class="stat-value num">~200</span>campaigns launched</div>
                <div class="card"><span class="stat-value num">~12</span>working days saved a year (est.)</div>
              </div>
            </div>
          </section>
          <section class="callout is-pale" aria-labelledby="c4">
            <h2 id="c4" style="font-size:24px;display:flex;align-items:center;gap:12px"><span class="n" style="display:inline-flex;width:30px;height:30px;border-radius:8px;background:var(--blue);color:var(--white);align-items:center;justify-content:center;font-size:15px;font-family:var(--text)">4</span>Next time</h2>
            <p>Connect CRM stages and server-side tracking before scaling spend, and move to value-based bidding sooner, so Google and Meta favour high-value investment prospects over small policy inquiries.</p>
          </section>
        </>
      )}

      {id === 'panasia' && (
        <>
          <figure class="creative">
            <img src="/images/campaigns/gold2cash.webp" width="554" height="554" alt="Gold2Cash ad for Pan Asia Bank: gold jewellery on a cobwebbed stand under the headline Make your gold work for you" style="max-width:560px" />
            <figcaption><b>The insight:</b> gold kept at home earns nothing. The cobwebs say it before the headline does.</figcaption>
          </figure>
          <section class="case-section" aria-labelledby="c1">
            <h2 id="c1"><span class="n">1</span>Problem</h2>
            <p>The bank needed funded gold loans. Cost per lead was the easy scoreboard, but a lead isn’t a loan.</p>
          </section>
          <section class="case-section" aria-labelledby="c2">
            <h2 id="c2"><span class="n">2</span>What I built</h2>
            <p>I launched on a US$25,000 budget, then re-split it every month toward the channel whose leads became funded loans, using the bank’s sales feedback.</p>
            <figure class="card case-figure" aria-label="Budget decisions by month">
              <ol class="timeline-h" style="grid-template-columns:repeat(5,minmax(0,1fr));list-style:none;margin:0;padding:0">
                <li><span class="dot"></span><span class="when">February</span><strong>Launch</strong><span>US$25K</span></li>
                <li><span class="dot"></span><span class="when">March</span><strong>Re-split</strong><span>To funded loans</span></li>
                <li><span class="dot"></span><span class="when">April</span><strong>Re-split</strong><span>To funded loans</span></li>
                <li><span class="dot"></span><span class="when">May</span><strong>Re-split</strong><span>To funded loans</span></li>
                <li><span class="dot is-key"></span><span class="when">June</span><strong>Settled</strong><span>60/40 Meta/Google</span></li>
              </ol>
            </figure>
            <figure class="card case-figure">
              <figcaption class="chart-title">Where the budget settled</figcaption>
              <div class="split"><span style="flex:60;background:var(--blue);color:var(--white)">Meta 60%</span><span style="flex:40;background:var(--pale-2);color:var(--ink);justify-content:flex-end">Google 40%</span></div>
            </figure>
          </section>
          <section class="case-section" aria-labelledby="c3">
            <h2 id="c3"><span class="n">3</span>What moved</h2>
            <div class="tiles is-3">
              <div class="tile is-lead"><span class="stat-value num">259</span><small>funded gold loans, traced through the lead form</small></div>
              <div class="card tile"><span class="stat-value num">~US$500K</span><small>in funded loans</small></div>
              <div class="card tile"><span class="stat-value num">US$97</span><small>media cost per funded loan</small></div>
            </div>
            <figure class="card case-figure">
              <figcaption class="chart-title">Funded gold loans per month: ~2.4× the bank’s prior volume</figcaption>
              <div class="bar-row"><span>Before (bank estimate)</span><span class="bar-track"><span class="bar" style="width:36%"></span><strong class="num">~21 a month</strong></span></div>
              <div class="bar-row"><span>During the campaign</span><span class="bar-track"><span class="bar bar-blue" style="width:86%"></span><strong class="num">~52 a month</strong></span></div>
              <p class="chart-note">Before: ~127 loans in six months (bank estimate). During: 259 ad-traced loans in five months.</p>
            </figure>
          </section>
          <section class="card callout" aria-labelledby="c-push">
            <h2 id="c-push" style="font-size:22px">The pushback</h2>
            <p>The bank asked why our cost per lead was so high. I showed cheaper leads weren’t becoming loans and held the targeting. Within weeks, quality leads were converting.</p>
          </section>
          <section class="callout is-pale" aria-labelledby="c4">
            <h2 id="c4" style="font-size:24px">Next time</h2>
            <p>Swap monthly manual sales reports for an automated CRM-to-ad-platform upload (even a scheduled Zapier job), cutting the loop from weeks to days.</p>
          </section>
        </>
      )}

      {id === 'godrej' && (
        <>
          <figure class="creative">
            <img src="/images/campaigns/godrej.webp" width="800" height="800" alt="Godrej Expert Rich Crème ad: a pixelated Error 404 with the line Sorry, no grey hair found" style="max-width:560px" />
            <figcaption><b>The insight:</b> “zero grey hair” gets scrolled past. A 404 joke gets stopped for, and makes the same promise.</figcaption>
          </figure>
          <section class="case-section" aria-labelledby="c1">
            <h2 id="c1"><span class="n">1</span>Problem</h2>
            <p>A hair colour launch on one of India’s most crowded beauty shelves, where every brand already promises full grey coverage.</p>
          </section>
          <section class="case-section" aria-labelledby="c2">
            <h2 id="c2"><span class="n">2</span>What I built</h2>
            <div class="flow">
              <div class="flow-box"><strong>Concept</strong>“Error 404,” developed with the team</div>
              <span class="flow-arrow" aria-hidden="true"><Icon name="arrow" size={16} /></span>
              <div class="flow-box"><strong>30 creators</strong>Their own posts became the ads, each with a promo code</div>
              <span class="flow-arrow" aria-hidden="true"><Icon name="arrow" size={16} /></span>
              <div class="flow-box is-blue"><strong>Amplify</strong>I ran Meta and YouTube: targeting, placements, US$30K</div>
            </div>
          </section>
          <section class="case-section" aria-labelledby="c3">
            <h2 id="c3"><span class="n">3</span>What moved</h2>
            <div class="tiles is-3">
              <div class="tile is-lead"><span class="stat-value num">~11.7×</span><small>promo-code-tracked retail sales per ad dollar</small></div>
              <div class="card tile"><span class="stat-value num">3.25%</span><small>Meta click-through rate</small></div>
              <div class="card tile"><span class="stat-value num">45%</span><small>YouTube view rate</small></div>
            </div>
            <figure class="card case-figure">
              <figcaption class="chart-title">Paid media budget vs. launch-quarter sales tracked by creator promo codes</figcaption>
              <div class="bar-row"><span>Paid media budget</span><span class="bar-track"><span class="bar" style="width:8%"></span><strong class="num">US$30K</strong></span></div>
              <div class="bar-row"><span>Tracked sales</span><span class="bar-track"><span class="bar bar-blue" style="width:86%"></span><strong class="num">~US$350K</strong></span></div>
              <p class="chart-note">Each creator had a unique promo code redeemed at retailers, so sales trace back to the paid campaign.</p>
            </figure>
          </section>
          <section class="callout is-pale" aria-labelledby="c4">
            <h2 id="c4" style="font-size:24px">Next time</h2>
            <p>Promo codes only caught buyers who used them. I’d add retargeting with retailer and quick-commerce links for high-intent viewers, plus a holdout test to measure the full lift.</p>
          </section>
        </>
      )}

      {id === 'petmart' && (
        <>
          <figure class="creative">
            <img src="/images/campaigns/petmart.webp" width="640" height="800" alt="Petmart and Sugar Beach Valentine’s ad: a golden retriever in a heart collar under the headline Pawfect Partner" style="max-width:480px" />
            <figcaption><b>The insight:</b> pet owners don’t want to leave the dog at home on date night.</figcaption>
          </figure>
          <section class="case-section" aria-labelledby="c1">
            <h2 id="c1"><span class="n">1</span>Problem</h2>
            <p>Grow Petmart’s audience and in-store sales around Valentine’s Day, when every brand is talking about love.</p>
          </section>
          <section class="case-section" aria-labelledby="c2">
            <h2 id="c2"><span class="n">2</span>What I built</h2>
            <figure class="card case-figure" aria-label="Campaign timeline">
              <ol class="timeline-h" style="grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;margin:0;padding:0">
                <li><span class="dot"></span><span class="when">January</span><strong>Giveaway</strong><span>3.5 weeks, organic</span></li>
                <li><span class="dot is-key"></span><span class="when">February 14</span><strong>The event</strong><span>Sugar Beach terrace, coupons handed out</span></li>
                <li><span class="dot"></span><span class="when">Late February</span><strong>Paid ads</strong><span>2 weeks, US$500, event coverage</span></li>
                <li><span class="dot"></span><span class="when">March to April</span><strong>Always-on</strong><span>Shopping and Performance Max</span></li>
              </ol>
            </figure>
            <p>For the always-on phase I built the Merchant Center feed and split Shopping and Performance Max by new and returning customers.</p>
          </section>
          <section class="case-section" aria-labelledby="c3">
            <h2 id="c3"><span class="n">3</span>What moved</h2>
            <div class="tiles is-3">
              <div class="tile is-lead"><span class="stat-value num">US$25K</span><small>in-store sales tracked by event coupon codes</small></div>
              <div class="card tile"><span class="stat-value num">1,700</span><small>giveaway entries</small></div>
              <div class="card tile"><span class="stat-value num">4:1</span><small>ROAS on Shopping and Performance Max, March to April</small></div>
            </div>
            <figure class="card case-figure">
              <figcaption class="chart-title">New followers during the giveaway</figcaption>
              <div class="bar-row"><span>Instagram</span><span class="bar-track"><span class="bar bar-blue" style="width:84%"></span><strong class="num">+1.2K</strong></span></div>
              <div class="bar-row"><span>Facebook</span><span class="bar-track"><span class="bar" style="width:67%"></span><strong class="num">+965</strong></span></div>
            </figure>
          </section>
          <section class="callout is-pale" aria-labelledby="c4">
            <h2 id="c4" style="font-size:24px">Next time</h2>
            <p>Coupon codes tracked the event’s sales, but the 1,700 entrants left no data trail. I’d gate entry behind an email or SMS opt-in with a first-purchase code, turning entrants into a customer list I could retarget.</p>
          </section>
        </>
      )}
    </article>

    <aside class="card case-aside" aria-label="Project facts">
      {id === 'aegon' && (
        <>
          <dl><dt>Employer</dt><dd>Aegon, insurance and investments</dd><dt>My role</dt><dd>Intermediate Channel Marketing Specialist (Paid Media)</dd><dt>When</dt><dd class="num">January 2025 to October 2026</dd><dt>Budget</dt><dd>Multi-million-dollar, co-managed with my team; I led LinkedIn, a seven-figure channel</dd><dt>Markets</dt><dd>Canada and the U.S.</dd></dl>
          <div class="block"><b>What I owned</b><p>Tracking, CRM integration, LinkedIn lead, hands-on Google and Meta, and U.S. agency direction with my director.</p></div>
          <div class="block"><b>Also at Aegon</b><p>Designed the strategy, target account list, audiences and reporting for a LinkedIn account-based marketing program aimed at high-net-worth investors, measured on investment deposits.</p><p>Built budget pacing dashboards that nearly eliminated quarterly overspend; presented biweekly results to senior leadership.</p><p>Helped move most of our paid media processes from an external agency in-house, for greater control of our marketing, lower costs and more efficiency through automation and agentic workflows.</p></div>
        </>
      )}
      {id === 'panasia' && (
        <>
          <dl><dt>Client</dt><dd>Pan Asia Bank, Gold2Cash gold loans</dd><dt>Agency</dt><dd>Kites Global</dd><dt>When</dt><dd class="num">February to June 2023</dd><dt>Budget</dt><dd class="num">US$25,000</dd><dt>Channels</dt><dd>Meta and Google</dd></dl>
          <div class="block"><b>Credits</b><p>Concept and paid media: Andrew. Design: Kites Global design team.</p></div>
        </>
      )}
      {id === 'godrej' && (
        <>
          <dl><dt>Client</dt><dd>Godrej Expert Rich Crème, India launch</dd><dt>Agency</dt><dd>Kites Global</dd><dt>When</dt><dd class="num">2023</dd><dt>Budget</dt><dd class="num">US$30,000 paid media</dd><dt>Channels</dt><dd>Meta and YouTube</dd></dl>
          <div class="block"><b>Credits</b><p>Paid media (Meta, YouTube), targeting and placements: Andrew. Strategy with the team. Creator selection: a colleague. Design: Kites Global.</p></div>
        </>
      )}
      {id === 'petmart' && (
        <>
          <dl><dt>Client</dt><dd>Petmart × Sugar Beach</dd><dt>Agency</dt><dd>Kites Global</dd><dt>When</dt><dd class="num">January to April 2023</dd><dt>Channels</dt><dd>Instagram, Facebook and Google</dd></dl>
          <div class="block"><b>Credits</b><p>Concept, partnership, social and paid media: Andrew. Design: Kites Global design team.</p></div>
        </>
      )}
    </aside>
  </div>

  <nav class="wrap" aria-label="Next story">
    {next ? (
      <a class="card next-story" href={`/case-studies/${next.id}/`}>
        <span><span class="meta">Next: {s.next.teaser}</span><b>{next.short}: {next.title}</b></span>
        <span class="pill pill-line">Read the story<Icon name="arrow" size={18} /></span>
      </a>
    ) : (
      <a class="card next-story" href="/#approach">
        <span><span class="meta">That’s all four stories</span><b>See the approach behind them</b></span>
        <span class="pill pill-line">Approach<Icon name="arrow" size={18} /></span>
      </a>
    )}
  </nav>
</Site>
