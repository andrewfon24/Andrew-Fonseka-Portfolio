    <a class="brand" href="/" style="color: var(--navy)">
      <span class="brand-monogram" aria-hidden="true">A<span>F</span></span>
      <span>Andrew Fonseka</span>
    </a>
    <h1>Let’s get you back to the work.</h1>
    <p>This page may have moved. The case studies are one click away.</p>
    <div class="hero-actions">
      <a class="btn btn-gold" href="/#work">Explore the case studies</a>
      <a class="btn btn-outline-light" href="mailto:rafandrewf@gmail.com">Email Andrew</a>
    </div>
  </main>
</SiteLayout>
