---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles.css";
import "../refinements.css";
import "../overrides.css";
---

<SiteLayout title="Page not found | Andrew Fonseka" noindex>
  <main class="container section" id="main">
    <a class="brand" href="/">
      Andrew Fonseka.
    </a>
    <h1 class="not-found-title">Let’s get you back to the work.</h1>
    <p>
      This page may have moved. Explore my case studies or contact me directly.
    </p>
    <div class="hero-actions">
      <a class="button primary" href="/#work">
        Explore the case studies
      </a>
      <a class="button secondary" href="mailto:rafandrewf@gmail.com">
        Email Andrew
      </a>
    </div>
  </main>
</SiteLayout>
