---
import SiteLayout from "../layouts/SiteLayout.astro";
import Icon from "../components/Icon.astro";
import { mailto } from "../content/site.js";
---

<SiteLayout title="Page not found | Andrew Fonseka" noindex contact={false}>
  <section class="band band--dark">
    <div class="container not-found">
      <h1>This page moved. <span class="accent">The work didn’t.</span></h1>
      <div class="actions">
        <a class="button button--primary" href="/#work">
          See the case studies <Icon name="arrow-right" size={17} class="icon-nudge" />
        </a>
        <a class="button button--ghost" href={mailto} data-track="email_click" data-where="404">
          <Icon name="mail" size={17} />Email Andrew
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
