{
  "redirects": [
    { "source": "/case-studies/university", "destination": "/#results", "permanent": true },
    { "source": "/case-studies/university/", "destination": "/#results", "permanent": true },
    { "source": "/case-studies/dats", "destination": "/#results", "permanent": true },
    { "source": "/case-studies/dats/", "destination": "/#results", "permanent": true }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ]
}
