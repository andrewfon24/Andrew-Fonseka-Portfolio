{
  "name": "andrew-fonseka-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0 --ignore-lock",
    "test": "npm run build && playwright test",
    "test:ui": "playwright test --ui",
    "format": "prettier --plugin=prettier-plugin-astro --write src tests astro.config.mjs playwright.config.js README.md docs package.json"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.4.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
